#include <winver.h>

1 VERSIONINFO
FILEVERSION @WIN_RELEASE_VERSION_RC@,0
PRODUCTVERSION @WIN_RELEASE_VERSION_RC@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@COD2_WINDOWS_COMPANY@"
            VALUE "FileDescription", "CoD2 Unbound"
            VALUE "FileVersion", "@WIN_RELEASE_VERSION@"
            VALUE "ProductName", "CoD2 Unbound"
            VALUE "ProductVersion", "@WIN_RELEASE_VERSION@"
            VALUE "OriginalFilename", "@WIN_TARGET@.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
