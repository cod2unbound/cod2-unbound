{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Player Setup popularity",
  "type": "object",
  "required": ["schemaVersion", "periodDays", "generatedDate", "setups"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "periodDays": { "type": "integer", "minimum": 1, "maximum": 366 },
    "generatedDate": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "setups": {
      "type": "object",
      "maxProperties": 2048,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "imports": { "type": "integer", "minimum": 5, "maximum": 9007199254740991 },
          "views": { "type": "integer", "minimum": 5, "maximum": 9007199254740991 }
        }
      }
    }
  }
}
