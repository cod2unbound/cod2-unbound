<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <ApplicationIcon>Assets/mark.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationTitle>CoD2 Unbound</ApplicationTitle>
    <Version>0.5.0</Version>
    <Product>CoD2 Unbound</Product>
    <!-- The portable projects already lock their own restores. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <UpdateBuildProfile Condition="'$(UpdateBuildProfile)' == ''">Public</UpdateBuildProfile>
    <EnableLocalReportReceivers Condition="'$(EnableLocalReportReceivers)' == ''">false</EnableLocalReportReceivers>
    <EnableLocalUpdateFeed Condition="'$(EnableLocalUpdateFeed)' == ''">false</EnableLocalUpdateFeed>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UpdateBuildProfile)' == 'Fixture'">
    <DefineConstants>$(DefineConstants);UPDATE_FIXTURES</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UpdateBuildProfile)' == 'Fixture' and '$(EnableLocalUpdateFeed)' == 'true'">
    <DefineConstants>$(DefineConstants);LOCAL_UPDATE_FEED</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UpdateBuildProfile)' == 'Fixture' and '$(EnableLocalReportReceivers)' == 'true'">
    <DefineConstants>$(DefineConstants);LOCAL_REPORT_RECEIVERS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(UpdateBuildProfile)' == 'Fixture' and '$(EnableLocalReportReceivers)' == 'true'">
    <AssemblyMetadata Include="CoD2Unbound.ReportingFixture" Value="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(UpdateBuildProfile)' != 'Fixture'">
    <Page Remove="Fixtures/StylePartsWindow.xaml" />
    <Compile Remove="Fixtures/StylePartsWindow.xaml.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(UpdateBuildProfile)' == 'Fixture'">
    <AssemblyMetadata Include="CoD2Unbound.UpdateFixture" Value="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(UpdatePublisherRules)' != ''">
    <AssemblyMetadata Include="UpdatePublisherRules" Value="$(UpdatePublisherRules)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsagePostHogKey)' != ''">
    <AssemblyMetadata Include="UsagePostHogKey" Value="$(UsagePostHogKey)" />
  </ItemGroup>
  <ItemGroup Condition="'$(CrashReportDsn)' != ''">
    <AssemblyMetadata Include="CrashReportDsn" Value="$(CrashReportDsn)" />
  </ItemGroup>
  <Target Name="ValidateUpdateBuild" BeforeTargets="CoreCompile">
    <Error Condition="'$(UpdateBuildProfile)' == 'Public' and ('$(EnableLocalReportReceivers)' != 'false' or $([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;, ])LOCAL_REPORT_RECEIVERS($|[;, ])')))"
           Text="Public launchers cannot include reporting fixture support." />
    <Error Condition="'$(UsagePostHogKey)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(UsagePostHogKey)', '\Aphc_[A-Za-z0-9_-]{1,200}\z'))"
           Text="UsagePostHogKey does not match the usage ingestion key format." />
    <Error Condition="'$(UpdateBuildProfile)' == 'Public' and '$(CrashReportDsn)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(CrashReportDsn)', '\Ahttps://[A-Za-z0-9]{1,64}@[A-Za-z0-9.-]+(?::[0-9]{1,5})?/(?:[A-Za-z0-9_-]+/)*[0-9]{1,20}/?\z'))"
           Text="CrashReportDsn must be an HTTPS public-key DSN." />
    <Error Condition="'$(UpdateBuildProfile)' != 'Public' and '$(UpdateBuildProfile)' != 'Fixture'"
           Text="UpdateBuildProfile must be Public or Fixture." />
    <Error Condition="'$(UpdateBuildProfile)' == 'Public' and ('$(EnableLocalUpdateFeed)' != 'false' or $([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;, ])(LOCAL_UPDATE_FEED|UPDATE_FIXTURES)($|[;, ])')))"
           Text="Public launchers cannot include updater fixture support." />
    <Error Condition="'$(UpdatePublisherRules)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(UpdatePublisherRules)', '\A[0-9a-fA-F]{64}=(?:1\.3\.6\.1\.4\.1|2\.25)(?:\.(?:0|[1-9][0-9]*)){2,}(?:\|[0-9a-fA-F]{64}=(?:1\.3\.6\.1\.4\.1|2\.25)(?:\.(?:0|[1-9][0-9]*)){2,})*\z'))"
           Text="UpdatePublisherRules must contain | separated SHA-256=publisher OID pairs." />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="[2.7.0]" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="[10.0.26100.7175]" PrivateAssets="all" />
    <ProjectReference Include="../CoD2Unbound.Core/CoD2Unbound.Core.csproj" />
    <Content Include="Assets/hero-*.svg;Assets/BigShouldersStencilDisplay-*.ttf;Assets/FluentSystemIcons-*.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="Assets/mark-16.png;Assets/mark-48.png;Assets/mark-372.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets/LICENSE-FluentSystemIcons.txt;Assets/mark.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/brand/wordmark.svg;../../docs/brand/wordmark-ink.svg"
             Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../launcher/Resources/Fonts/OFL-BigShouldersStencilDisplay.txt;../../launcher/Resources/Fonts/CourierPrime-*.ttf;../../launcher/Resources/Fonts/OFL-CourierPrime.txt"
             Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Notices/*.txt" LogicalName="Notice.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../tools/windows/package/THIRD-PARTY.txt" LogicalName="Notice.third-party.txt" />
    <EmbeddedResource Include="../../NOTICE.md" LogicalName="Notice.provenance.txt" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="Notice.unbound.txt" />
    <EmbeddedResource Include="../../third_party/minimp3/LICENSE" LogicalName="Notice.minimp3.txt" />
    <EmbeddedResource Include="../../launcher/Resources/Fonts/OFL-BigShouldersStencilDisplay.txt" LogicalName="Notice.big-shoulders.txt" />
    <EmbeddedResource Include="../../launcher/Resources/Fonts/OFL-CourierPrime.txt" LogicalName="Notice.courier-prime.txt" />
    <EmbeddedResource Include="Assets/LICENSE-FluentSystemIcons.txt" LogicalName="Notice.fluent-icons.txt" />
  </ItemGroup>
  <!-- Windows App SDK 2.7.0 builds the app PRI but omits it from unpackaged publish output. -->
  <Target Name="IncludeLauncherPriInPublish" BeforeTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="$(GenerateProjectPriFile)" Condition="'$(WindowsPackageType)' == 'None'">
    <Error Condition="!Exists('$(ProjectPriFullPath)')" Text="The launcher resource index is missing." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
