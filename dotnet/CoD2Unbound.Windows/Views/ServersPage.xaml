<Page x:Class="CoD2Unbound.Windows.Views.ServersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:views="using:CoD2Unbound.Windows.Views"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="PageLayout" SizeChanged="OnBrowserSizeChanged" RowDefinitions="Auto,*">
        <Viewbox x:Name="ServersContours" Grid.RowSpan="2" Stretch="Fill" IsHitTestVisible="False"
                 AutomationProperties.AccessibilityView="Raw">
            <Canvas Width="1440" Height="900" Opacity="0.035">
                <Path Stroke="{ThemeResource accent}" StrokeThickness="1.2"
                      Data="M260 120 C420 60 620 90 760 150 S1100 260 1440 180 M260 170 C430 110 610 140 770 200 S1110 310 1440 230
                            M260 225 C440 165 600 195 780 255 S1120 365 1440 285 M260 285 C450 225 590 255 790 315 S1130 425 1440 345
                            M980 520 C1060 470 1180 470 1240 520 S1300 640 1210 680 S1010 640 980 520 Z" />
            </Canvas>
        </Viewbox>
        <Grid x:Name="ServerToolbar" Margin="20,12,20,16" VerticalAlignment="Top"
              RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" SizeChanged="OnToolbarSizeChanged">
            <SelectorBar x:Name="Scopes" AutomationProperties.Name="Server lists" VerticalAlignment="Center"
                         SelectionChanged="OnScopeChanged">
                <SelectorBarItem Text="All" AccessKey="A" />
                <SelectorBarItem Text="Favorites" AccessKey="V" />
                <SelectorBarItem x:Name="RecentScope" Text="Recent" AccessKey="N" />
                <SelectorBarItem Text="Hosting" AutomationProperties.AutomationId="HostingTab" AccessKey="T" />
            </SelectorBar>
            <StackPanel x:Name="BrowserTools" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <AutoSuggestBox x:Name="SearchBox" Width="280"
                                PlaceholderText="Search servers, maps or mods"
                                AutomationProperties.Name="Search servers, maps or mods"
                                AutomationProperties.AcceleratorKey="Ctrl+F"
                                TextChanged="OnSearch" QuerySubmitted="OnSearchSubmitted">
                    <AutoSuggestBox.QueryIcon>
                        <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentSearch}" FontSize="16" />
                    </AutoSuggestBox.QueryIcon>
                    <AutoSuggestBox.TextBoxStyle>
                        <Style TargetType="TextBox" BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}">
                            <Setter Property="MaxLength" Value="256" />
                        </Style>
                    </AutoSuggestBox.TextBoxStyle>
                </AutoSuggestBox>
                <Button x:Name="FilterButton" AccessKey="F" AutomationProperties.Name="Filters">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentFilter}" FontSize="16" />
                        <TextBlock Text="Filters" VerticalAlignment="Center" />
                        <Border x:Name="FilterBadge" Style="{StaticResource Cod2xTag}" Padding="4,0" Visibility="Collapsed">
                            <TextBlock x:Name="FilterCount" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Opening="OnFiltersOpening" Placement="Bottom" FlyoutPresenterStyle="{StaticResource InsetFormPopover}">
                            <ScrollViewer x:Name="FiltersScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">
                                <Border Style="{StaticResource SheetFormGroup}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource InsetFormRow}" ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Game version" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <SelectorBar x:Name="FilterEdition" Grid.Column="1" AutomationProperties.Name="Version"
                                                         SelectionChanged="OnEditionFilterSelection">
                                                <SelectorBarItem Text="Any" />
                                                <SelectorBarItem Text="CoD2x" />
                                                <SelectorBarItem Text="Original 1.3" />
                                            </SelectorBar>
                                        </Grid>
                                        <Border Style="{StaticResource CardDivider}" Height="1" />
                                        <Grid Style="{StaticResource InsetFormRow}" ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Game mode" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <ComboBox x:Name="FilterMode" Grid.Column="1" SelectionChanged="OnFilterSelection"
                                                      AutomationProperties.Name="Game type" />
                                        </Grid>
                                        <Border Style="{StaticResource CardDivider}" Height="1" />
                                        <Grid Style="{StaticResource InsetFormRow}" ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Ping" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <ComboBox x:Name="FilterPing" Grid.Column="1" SelectionChanged="OnFilterSelection"
                                                      AutomationProperties.Name="Maximum ping" />
                                        </Grid>
                                        <Border Style="{StaticResource CardDivider}" Height="1" />
                                        <Grid Style="{StaticResource InsetFormRow}" ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Hide empty servers" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="HideEmpty" Grid.Column="1" MinWidth="0" Toggled="OnFilterToggle"
                                                          AutomationProperties.Name="Hide empty servers" />
                                        </Grid>
                                        <Border Style="{StaticResource CardDivider}" Height="1" />
                                        <Grid Style="{StaticResource InsetFormRow}" ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Hide full servers" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="HideFull" Grid.Column="1" MinWidth="0" Toggled="OnFilterToggle"
                                                          AutomationProperties.Name="Hide full servers" />
                                        </Grid>
                                        <Border Style="{StaticResource CardDivider}" Height="1" />
                                        <Grid Style="{StaticResource InsetFormRow}" ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Hide servers that need a password" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="HidePassworded" Grid.Column="1" MinWidth="0" Toggled="OnFilterToggle"
                                                          AutomationProperties.Name="Hide passworded servers" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="FilterSummary" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                    <Button x:Name="ClearFilters" Grid.Column="1" Content="Reset" Click="OnClearFilters" />
                                </Grid>
                            </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <StackPanel x:Name="BrowserActions" Grid.Column="2" Orientation="Horizontal" Spacing="12">
                <Border x:Name="RefreshPill" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="RefreshStatus" Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="NoWrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="RefreshButton" Style="{StaticResource IconAction}" AccessKey="R" Click="OnRefresh"
                                AutomationProperties.AcceleratorKey="F5, Ctrl+R" AutomationProperties.Name="Refresh server list">
                            <FontIcon x:Name="RefreshGlyph" FontFamily="{StaticResource FluentRegular}"
                                      Glyph="{StaticResource FluentRefresh}" FontSize="17" />
                        </Button>
                    </StackPanel>
                </Border>
                <Button x:Name="ConnectButton" AccessKey="C" Click="OnConnect"
                        AutomationProperties.Name="Connect to address…" AutomationProperties.AcceleratorKey="Ctrl+L">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentAdd}" FontSize="18" />
                        <TextBlock Text="Connect to Address…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="ToolbarOverflow"
                        Visibility="Collapsed" AutomationProperties.Name="More toolbar items">
                    <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentMore}" FontSize="18" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="OverflowCount" IsEnabled="False" />
                            <MenuFlyoutItem x:Name="OverflowRefresh" Text="Refresh Server List" Click="OnRefresh"
                                            KeyboardAcceleratorTextOverride="F5, Ctrl+R" />
                            <MenuFlyoutItem Text="Connect to Address…" Click="OnConnect" KeyboardAcceleratorTextOverride="Ctrl+L"
                                            AutomationProperties.Name="Connect to address…" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <StackPanel x:Name="HostingActions" Grid.Column="2" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                <Button x:Name="ExportHost" AccessKey="X"
                        AutomationProperties.Name="Export for another machine…" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentDocument}" FontSize="15" />
                        <TextBlock Text="Export for Another PC…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button AccessKey="N" Click="OnNewHostedServer" AutomationProperties.Name="New server" AutomationProperties.AutomationId="HostingNewServer">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentAdd}" FontSize="15" />
                        <TextBlock Text="New Server" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Grid x:Name="HostingLayout" Grid.Row="1" RowDefinitions="Auto,*" Visibility="Collapsed">
            <InfoBar x:Name="HostingExportStatus" Margin="42,0,32,12" Visibility="Collapsed" />
            <ContentPresenter x:Name="HostingContent" Grid.Row="1" />
        </Grid>
        <Grid x:Name="BrowserContent" Grid.Row="1" ColumnSpacing="22" Margin="22,0,18,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid MaxWidth="790">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="16,12,0,18" Spacing="6">
                    <TextBlock Text="Servers" Style="{StaticResource PageTitle}" LineStackingStrategy="BlockLineHeight" />
                    <TextBlock Style="{StaticResource SecondaryText}"
                               Text="Original 1.3 and CoD2x servers from the public master lists. Nothing is contacted until you refresh." />
                </StackPanel>
                <Grid Grid.Row="1" Margin="10,0,0,12" Padding="14,10,11,10" ColumnDefinitions="*,Auto"
                      ColumnSpacing="12" CornerRadius="{ThemeResource OverlayCornerRadius}"
                      Background="{ThemeResource well}" BorderBrush="{ThemeResource wellStroke}"
                      BorderThickness="{StaticResource Stroke}" x:Name="RefreshBanner" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" Spacing="6">
                        <TextBlock x:Name="RefreshMessage" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <ProgressBar x:Name="RefreshProgressBar" AutomationProperties.Name="Refreshing the server list" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Stop" Click="OnRefresh" />
                </Grid>
                <InfoBar x:Name="OfflineBanner" Grid.Row="1" Margin="10,0,0,12" Visibility="Collapsed"
                         Severity="Error" IsClosable="False">
                    <InfoBar.ActionButton><Button Content="Try Again" Click="OnRefresh" /></InfoBar.ActionButton>
                </InfoBar>
                <Grid x:Name="ColumnHeaders" Grid.Row="2" ColumnSpacing="16" Padding="11,0,21,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Map" VerticalAlignment="Center" Style="{StaticResource SecondaryCaption}" />
                    <Button x:Name="SortName" Grid.Column="1" Content="Server" Style="{StaticResource ColumnHeading}" Tag="Name" Click="OnSort" HorizontalContentAlignment="Left" />
                    <Button x:Name="SortPlayers" Grid.Column="2" Content="Players" Style="{StaticResource ColumnHeading}" Tag="Players" Click="OnSort" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Padding="0" />
                    <Button x:Name="SortPing" Grid.Column="3" Content="Ping" Style="{StaticResource ColumnHeading}" Tag="Ping" Click="OnSort" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Padding="0" />
                </Grid>
                <ListView x:Name="ServerList" Grid.Row="3" SelectionChanged="OnSelectionChanged"
                          SizeChanged="OnServerListSizeChanged"
                          AutomationProperties.Name="Servers">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="11,11,21,11" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="16" MinHeight="60" Background="Transparent" AutomationProperties.Name="{Binding Label}"
                                  Loaded="OnServerRowLoaded" DataContextChanged="OnServerRowChanged" DoubleTapped="OnServerRowDoubleTapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="RowIdentity" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource MediaTile}" Height="60">
                                        <Image x:Name="RowArt" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                        <Grid views:GlyphAlign.IsEnabled="True" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" x:Name="RowName" TextTrimming="CharacterEllipsis" />
                                            <FontIcon Grid.Column="1" FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentLock}" FontSize="12"
                                                      Visibility="{Binding Lock}" AutomationProperties.Name="Password required" />
                                        </Grid>
                                        <Grid ColumnSpacing="4" HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" x:Name="RowMapMode" Text="{Binding MapMode}"
                                                       MaxWidth="176" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" x:Name="RowEdition" Style="{StaticResource EditionTag}">
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" x:Name="RowEditionText" Text="{Binding Edition}"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Border Grid.Column="2" x:Name="RowMod" Style="{StaticResource EditionTag}" Visibility="{Binding ModVisibility}" MaxWidth="80">
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding Mod}" VerticalAlignment="Center"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="RowPlayers" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel x:Name="RowSignal" Orientation="Horizontal" Spacing="2" Height="12"
                                                AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" x:Name="RowPing" Text="{Binding Ping}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button x:Name="RowFavorite" Grid.Column="3" Style="{StaticResource IconAction}"
                                        Click="OnRowFavorite" VerticalAlignment="Center" Tag="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyServers" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Spacing="8" MaxWidth="360" Margin="16,110,16,0" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyHeading" Style="{StaticResource EmptyHeading}" TextAlignment="Center" />
                    <TextBlock x:Name="EmptyMessage" Style="{StaticResource SecondaryText}" TextAlignment="Center" />
                    <Button x:Name="EmptyAction" HorizontalAlignment="Center" Style="{StaticResource MediumButton}" Click="OnEmptyAction" />
                </StackPanel>
            </Grid>
            <Border x:Name="Details" Grid.Column="1" Width="352" Margin="0,8,0,0" Padding="14"
                    Style="{StaticResource GroupCard}" CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Background="{ThemeResource PanelBrush}" AutomationProperties.Name="Server details">
                <Grid>
                    <StackPanel x:Name="NoDetails" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                        <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentLive}" FontSize="30"
                                  HorizontalAlignment="Center" Foreground="{ThemeResource tertiary}" />
                        <TextBlock Text="Select a server to see its map, rules and who’s playing." TextAlignment="Center"
                                   Style="{StaticResource SecondaryText}" MaxWidth="240" />
                    </StackPanel>
                    <Grid x:Name="SelectedDetails" RowSpacing="12" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <Border x:Name="DetailArtwork" Height="150" CornerRadius="{ThemeResource OverlayCornerRadius}">
                                    <Image x:Name="DetailArt" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Spacing="6" Margin="6,0">
                                    <TextBlock x:Name="DetailMap" Style="{StaticResource Eyebrow}" Foreground="{ThemeResource accent}" />
                                    <TextBlock x:Name="DetailName" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock x:Name="DetailAddress" IsTextSelectionEnabled="True" VerticalAlignment="Center"
                                                   MaxWidth="214" Style="{StaticResource AddressText}" />
                                        <Button Style="{StaticResource IconAction}" Click="OnCopyAddress"
                                                AutomationProperties.Name="Copy server address" ToolTipService.ToolTip="Copy server address">
                                            <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentCopy}" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <Grid Margin="6,0" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                                      ColumnSpacing="8" RowSpacing="8">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Version" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" x:Name="DetailVersion" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="Mod" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" x:Name="DetailMod" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="3">
                                        <TextBlock Text="Access" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" x:Name="DetailAccess" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" x:Name="DetailFull" Text="This server is full." TextWrapping="Wrap"
                                           Foreground="{ThemeResource AddressBrush}" Visibility="Collapsed" />
                                <ContentControl x:Name="DetailReady" Margin="6,0" HorizontalContentAlignment="Stretch" IsTabStop="False" />
                                <Border Height="1" Margin="6,0" Background="{ThemeResource SeparatorBrush}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DetailRoster" Style="{StaticResource Eyebrow}" Foreground="{ThemeResource tertiary}" />
                                    <TextBlock Grid.Column="1" Text="Score" Style="{StaticResource SecondaryCaption}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="Ping" Style="{StaticResource SecondaryCaption}" TextAlignment="Right" />
                                </Grid>
                                <StackPanel x:Name="Roster" Spacing="2" Margin="6,0" />
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="1" ColumnSpacing="8" Margin="6,0,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="JoinButton" AutomationProperties.Name="Launch" HorizontalAlignment="Stretch"
                                    Style="{StaticResource AccentButtonStyle}" AccessKey="L" Click="OnJoin">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{StaticResource FluentFilled}" Glyph="{StaticResource FluentPlay}" FontSize="16" />
                                    <TextBlock x:Name="JoinButtonLabel" Text="Launch" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="FavoriteButton" Grid.Column="1" AccessKey="E" Click="OnFavorite" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Button x:Name="ClearRecent" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,398,24" Click="OnClearRecent" Style="{StaticResource SmallSubtleAction}" Visibility="Collapsed"
                Content="Clear Recent" />
    </Grid>
</Page>
