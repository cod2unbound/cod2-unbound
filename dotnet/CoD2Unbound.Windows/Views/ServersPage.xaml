<Page x:Class="CoD2Unbound.Windows.Views.ServersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshShortcut" />
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnRefreshShortcut" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchShortcut" />
        <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="OnConnectShortcut" />
    </Page.KeyboardAccelerators>
    <Grid Padding="32,24,32,24" RowSpacing="12" SizeChanged="OnBrowserSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Servers" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="RefreshStatus" FontSize="12" Style="{StaticResource SecondaryText}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <StackPanel x:Name="BrowserActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button x:Name="RefreshButton" Style="{StaticResource IconAction}" AccessKey="R" Click="OnRefresh"
                        ToolTipService.ToolTip="Refresh server list (Ctrl+R)"
                        AutomationProperties.AcceleratorKey="F5, Ctrl+R" AutomationProperties.Name="Refresh server list">
                    <FontIcon x:Name="RefreshGlyph" Glyph="&#xE72C;" FontSize="16" />
                </Button>
                <Button Content="Connect to address…" AccessKey="C" Click="OnConnect"
                        AutomationProperties.AcceleratorKey="Ctrl+L" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="Scopes" AutomationProperties.Name="Server lists"
                         Style="{StaticResource AlignedSelector}" SelectionChanged="OnScopeChanged">
                <SelectorBarItem Text="All" AccessKey="A" />
                <SelectorBarItem Text="Favorites" AccessKey="V" />
                <SelectorBarItem x:Name="RecentScope" Text="Recent" AccessKey="N" />
                <SelectorBarItem Text="Hosting" AccessKey="T" />
            </SelectorBar>
            <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search servers, maps or mods"
                     AutomationProperties.Name="Search servers, maps or mods" AutomationProperties.AcceleratorKey="Ctrl+F"
                     TextChanged="OnSearch" VerticalAlignment="Center" MaxLength="256" />
            <Button x:Name="FilterButton" Grid.Column="2" Content="Filters" AccessKey="F" VerticalAlignment="Center">
                <Button.Flyout>
                    <Flyout Opening="OnFiltersOpening">
                        <StackPanel Spacing="8" Width="200">
                            <ComboBox x:Name="FilterEdition" Header="Version" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="All" />
                                <ComboBoxItem Content="CoD2x 1.4.6.8" />
                                <ComboBoxItem Content="Original 1.3" />
                            </ComboBox>
                            <ComboBox x:Name="FilterMode" Header="Game type" HorizontalAlignment="Stretch" />
                            <ComboBox x:Name="FilterPing" Header="Maximum ping" HorizontalAlignment="Stretch" />
                            <CheckBox x:Name="HideEmpty" Content="Hide empty servers" />
                            <CheckBox x:Name="HideFull" Content="Hide full servers" />
                            <CheckBox x:Name="HidePassworded" Content="Hide passworded servers" />
                            <Button Content="Apply" Click="OnApplyFilters" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>
        <ContentPresenter x:Name="HostingContent" Grid.Row="2" Visibility="Collapsed" />
        <Grid x:Name="BrowserContent" Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8" Padding="12,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Server" Style="{StaticResource ColumnHeading}" Tag="Name" Click="OnSort" />
                    <Button Grid.Column="1" Content="Players" Style="{StaticResource ColumnHeading}" Tag="Players" Click="OnSort" />
                    <Button Grid.Column="2" Content="Ping" Style="{StaticResource ColumnHeading}" Tag="Ping" Click="OnSort" />
                </Grid>
                <ListView x:Name="ServerList" Grid.Row="1" SelectionChanged="OnSelectionChanged"
                          AutomationProperties.Name="Servers">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" MinHeight="62" AutomationProperties.Name="{Binding Label}"
                                  Loaded="OnServerRowLoaded" DataContextChanged="OnServerRowChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource MediaTile}" Height="48">
                                        <Image x:Name="RowArt" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="RowName" TextTrimming="CharacterEllipsis" />
                                            <FontIcon Grid.Column="1" Glyph="&#xE72E;" FontSize="12"
                                                      Visibility="{Binding Lock}" AutomationProperties.Name="Password required" />
                                        </Grid>
                                        <TextBlock Text="{Binding MapMode}" Style="{StaticResource SecondaryText}" FontSize="12"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Border x:Name="RowEdition" Style="{StaticResource EditionTag}">
                                                <TextBlock x:Name="RowEditionText" Text="{Binding Edition}" FontSize="12"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Border Style="{StaticResource EditionTag}" Visibility="{Binding ModVisibility}" MaxWidth="80">
                                                <TextBlock Text="{Binding Server.Mod}" FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="RowPlayers" Grid.Column="1" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <StackPanel x:Name="RowSignal" Orientation="Horizontal" Spacing="2" Height="12"
                                                AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="{Binding Ping}" VerticalAlignment="Center" FontSize="12" />
                                </StackPanel>
                                <Button x:Name="RowFavorite" Grid.Column="3" Style="{StaticResource IconAction}"
                                        Click="OnRowFavorite" VerticalAlignment="Center" Tag="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Border x:Name="Details" Grid.Column="1" Width="300" Style="{StaticResource FieldCard}" Visibility="Collapsed">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <Border Height="120" CornerRadius="4">
                                <Image x:Name="DetailArt" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock x:Name="DetailMap" Style="{StaticResource Eyebrow}" />
                            <TextBlock x:Name="DetailName" Style="{StaticResource CardTitle}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="DetailAddress" IsTextSelectionEnabled="True" VerticalAlignment="Center"
                                           MaxWidth="214" Style="{StaticResource AddressText}" />
                                <Button Style="{StaticResource IconAction}" Click="OnCopyAddress"
                                        AutomationProperties.Name="Copy server address" ToolTipService.ToolTip="Copy server address">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                </Button>
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Version" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Name="DetailVersion" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Mod" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Name="DetailMod" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Access" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Name="DetailAccess" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="DetailReady" Foreground="{ThemeResource PositiveBrush}" FontSize="12"
                                       TextWrapping="Wrap" Visibility="Collapsed" />
                            <Border Height="1" Background="{ThemeResource SeparatorBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DetailRoster" Style="{StaticResource SecondaryText}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="Score" Style="{StaticResource SecondaryText}" FontSize="12" TextAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="Ping" Style="{StaticResource SecondaryText}" FontSize="12" TextAlignment="Right" />
                            </Grid>
                            <StackPanel x:Name="Roster" Spacing="4" />
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="JoinButton" Content="Launch" HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}" AccessKey="L" Click="OnJoin" />
                        <Button x:Name="FavoriteButton" Grid.Column="1" AccessKey="E" Click="OnFavorite" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
