<Page x:Class="CoD2Unbound.Windows.Views.SetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Enter" Invoked="OnDefaultAction" />
        <KeyboardAccelerator Key="Escape" Invoked="OnCancelAction" />
    </Page.KeyboardAccelerators>
    <Grid x:Name="SetupFrame" SizeChanged="OnFrameSizeChanged">
        <ScrollViewer x:Name="SetupScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="Setup">
            <Grid x:Name="SetupStage" Padding="24,0,24,0">
                <StackPanel x:Name="SetupColumn" HorizontalAlignment="Center" Spacing="12">
                    <Image x:Name="SetupMark" Source="ms-appx:///Assets/mark-372.png" Width="124" Height="124"
                           HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                    <!-- Decorative: the step's name is read from the title and progress indicator. Kept out of UI
                         Automation so names such as "CD key" stay unique for the field. -->
                    <TextBlock x:Name="SetupEyebrow" Style="{StaticResource SetupEyebrow}" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="SetupTitle" Style="{StaticResource SetupTitle}" />
                    <TextBlock x:Name="SetupDescription" Style="{StaticResource SetupSubtitle}" />
                    <StackPanel x:Name="StepContent" Spacing="12" Margin="0,13,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <Border x:Name="SetupBar" Style="{StaticResource GroupCard}" MaxWidth="860" MinHeight="56"
                VerticalAlignment="Bottom" Margin="24,0,24,20" Padding="12,8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                <Button x:Name="SetupBack" Content="Back" Click="OnSetupBack" AccessKey="B" VerticalAlignment="Center" />
                <StackPanel x:Name="StepDots" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
                <TextBlock x:Name="StepLabel" Grid.Column="2" Style="{StaticResource SetupStepLabel}"
                           AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="SetupCancel" Content="Cancel" Click="OnCancelSetup" />
                    <Button x:Name="SetupAlternate" Click="OnAlternate" AutomationProperties.AutomationId="SetupAlternate" />
                    <Button x:Name="DeclineReport" Click="OnDeclineReport" Content="Don’t Send" AccessKey="N" />
                    <Button x:Name="SetupNext" Content="Continue" Click="OnContinueSetup"
                            Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="SetupNext" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
