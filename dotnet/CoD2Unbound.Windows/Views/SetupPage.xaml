<Page x:Class="CoD2Unbound.Windows.Views.SetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Enter" Invoked="OnDefaultAction" />
        <KeyboardAccelerator Key="Escape" Invoked="OnCancelAction" />
    </Page.KeyboardAccelerators>
    <!-- The scene is the shell's backdrop (IShellBackdrop), so it fills the window under the caption buttons,
         as the Mac's setup fills its window (SetupBackdrop). The page itself starts at the window's top-left. -->
    <Grid x:Name="SetupFrame" SizeChanged="OnFrameSizeChanged">
        <ScrollViewer x:Name="SetupScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="Setup">
            <Grid x:Name="SetupStage" Padding="24,0,24,0">
                <StackPanel x:Name="SetupColumn" HorizontalAlignment="Center" Spacing="12">
                    <Image x:Name="SetupMark" Source="ms-appx:///Assets/mark-372.png" Width="124" Height="124"
                           HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                    <!-- Decorative: the step's name is read from the title and the step capsules' name. Kept out of UI
                         Automation so names such as "CD key" stay unique for the field. -->
                    <TextBlock x:Name="SetupEyebrow" Style="{StaticResource SetupEyebrow}" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="SetupTitle" Style="{StaticResource SetupTitle}" />
                    <TextBlock x:Name="SetupDescription" Style="{StaticResource SetupSubtitle}" />
                    <StackPanel x:Name="StepContent" Spacing="12" Margin="0,13,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <Grid x:Name="SetupBar" MaxWidth="860" Height="{StaticResource SetupBarHeight}" VerticalAlignment="Bottom"
              Margin="24,0,24,22">
            <Border x:Name="SetupBarGlass" Style="{StaticResource SetupBar}" Margin="0" Padding="0" />
            <Border Style="{StaticResource SetupGlassHighlight}" CornerRadius="{StaticResource SetupBarRadius}" Margin="1" />
            <Grid Margin="11,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SetupBack" Content="Back" Click="OnSetupBack" AccessKey="B"
                            Style="{StaticResource SetupAction}" VerticalAlignment="Center" />
                    <StackPanel x:Name="StepDots" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="18,0,0,0"
                                VerticalAlignment="Center" />
                    <TextBlock x:Name="StepLabel" Grid.Column="2" Style="{StaticResource SetupStepLabel}" Margin="8,0,0,0"
                               AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="SetupCancel" Content="Cancel" Click="OnCancelSetup" Style="{StaticResource SetupAction}" />
                        <Button x:Name="SetupAlternate" Click="OnAlternate" Style="{StaticResource SetupAction}" />
                        <Button x:Name="DeclineReport" Click="OnDeclineReport" Content="Don’t Send" AccessKey="N"
                                Style="{StaticResource SetupAction}" />
                        <Button x:Name="SetupNext" Content="Continue" Click="OnContinueSetup"
                                Style="{StaticResource SetupPrimary}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
