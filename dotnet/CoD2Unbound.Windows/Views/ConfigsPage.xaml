<Page x:Class="CoD2Unbound.Windows.Views.ConfigsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{ThemeResource SeparatorBrush}" BorderThickness="0,0,1,0">
            <Grid Padding="12,24,12,16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Configs" Style="{StaticResource PageTitle}" Margin="8,0,8,8" />
                        <TextBlock Text="Discover" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="8,8,8,4" />
                        <ListView x:Name="DiscoverPlaces" AutomationProperties.Name="Discover" TabNavigation="Once"
                                  SelectionChanged="OnDiscoverPlaceChanged" ItemContainerStyle="{StaticResource SidebarItem}">
                            <ListViewItem AccessKey="P" AutomationProperties.Name="Player Setups" Style="{StaticResource SidebarItem}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE716;" FontSize="20" />
                                    <TextBlock Text="Player Setups" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem AccessKey="V" AutomationProperties.Name="Saved" Style="{StaticResource SidebarItem}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8A4;" FontSize="20" />
                                    <TextBlock Grid.Column="1" Text="Saved" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SavedCount" Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                               />
                                </Grid>
                            </ListViewItem>
                            <ListViewItem AutomationProperties.Name="Check a config" Style="{StaticResource SidebarItem}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xEA18;" FontSize="20" />
                                    <TextBlock Text="Check a config" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListViewItem>
                        </ListView>
                        <TextBlock Text="My loadouts" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="8,12,8,4" />
                        <ListView x:Name="Loadouts" TabNavigation="Once" ItemContainerStyle="{StaticResource SidebarItem}"
                                  AutomationProperties.Name="My loadouts" SelectionChanged="OnSelectLoadout">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="52" ColumnSpacing="12" AutomationProperties.Name="{Binding Name}" Loaded="OnLoadoutRowLoaded" ActualThemeChanged="OnLoadoutRowThemeChanged">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="LoadoutTile" Style="{StaticResource InitialTile}">
                                            <TextBlock Text="{Binding Initial}" Style="{StaticResource LoadoutInitial}"
                                                       AutomationProperties.AccessibilityView="Raw" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="LoadoutStatus" Text="{Binding Status}" FontSize="12" />
                                        </StackPanel>
                                        <FontIcon x:Name="LoadoutCheck" Grid.Column="2" Glyph="&#xE73E;" FontSize="16" Visibility="{Binding Checkmark}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button x:Name="NewLoadout" AccessKey="N" Click="OnNewLoadout" AutomationProperties.Name="New loadout"
                                Margin="0,4,0,0" Style="{StaticResource SidebarAction}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE710;" FontSize="20" />
                                <TextBlock Text="New loadout" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddConfig" AccessKey="I" AutomationProperties.Name="Add a config" Style="{StaticResource SidebarAction}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE896;" FontSize="20" />
                                <TextBlock Text="Add a config" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE70D;" FontSize="12" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Paste config text…" Click="OnAddConfig" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="1" Margin="8,0" FontSize="12" Style="{StaticResource SecondaryText}"
                           Text="Each loadout is its own Call of Duty 2 player profile, so the game sees exactly what you set here." />
            </Grid>
        </Border>
        <ScrollViewer x:Name="DetailScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="28,16,28,28" Spacing="12">
                <InfoBar x:Name="Status" IsClosable="True" />
                <StackPanel x:Name="Detail" Spacing="8" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
