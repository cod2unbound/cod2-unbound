<Page x:Class="CoD2Unbound.Windows.Views.ConfigsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:core="using:CoD2Unbound.Core">
    <Page.Resources>
        <DataTemplate x:Key="InstalledProfileHeader">
            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="10,8,0,4" />
        </DataTemplate>
        <DataTemplate x:Key="InstalledProfileRow">
            <StackPanel Spacing="3" Padding="8,6" AutomationProperties.Name="{Binding AccessibleName}">
                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="In use by the game" Style="{StaticResource PositiveCaption}" Visibility="{Binding ActiveVisibility}" />
                <TextBlock Text="Backup copy" Style="{StaticResource SecondaryText}" Visibility="{Binding BackupVisibility}" />
                <TextBlock Text="{Binding FileName}" Style="{StaticResource MonoCaption}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ShareLeftOutLine" x:DataType="core:ConfigShareLeftOut">
            <Grid ColumnSpacing="12" Padding="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="154" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Shown}" Style="{StaticResource MonoCaption}" TextWrapping="Wrap"
                           LineHeight="18" LineStackingStrategy="BlockLineHeight" />
                <TextBlock Grid.Column="1" Text="{x:Bind Because}" Style="{StaticResource SecondaryText}"
                           FontSize="12" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CheckerLine">
            <Border Padding="8,4" Loaded="OnCheckerLineLoaded" DataContextChanged="OnCheckerLineContextChanged"
                    ActualThemeChanged="OnCheckerLineThemeChanged" AutomationProperties.Name="{Binding AccessibleName}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Id}" Style="{StaticResource MonoCaption}" />
                    <TextBlock x:Name="LineMark" Grid.Column="1" Text="{Binding Icon}" />
                    <TextBlock x:Name="LineCode" Grid.Column="2" Text="{Binding Text}" Style="{StaticResource MonoCaption}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text}" />
                    <TextBlock x:Name="LineNote" Grid.Column="3" Text="{Binding Note}" Style="{StaticResource SecondaryText}" FontSize="12"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Note}" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CheckerFinding">
            <Grid ColumnSpacing="8" Padding="0,6" AutomationProperties.Name="{Binding AccessibleName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Line}" Style="{StaticResource MonoCaption}" Margin="0,3,0,0" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" />
                </StackPanel>
                <Button Grid.Column="2" Content="{Binding FixLabel}" Visibility="{Binding FixVisibility}"
                        AutomationProperties.Name="{Binding FixName}" Click="OnCheckerFix" />
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid x:Name="ConfigSurface" AllowDrop="True" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{ThemeResource SeparatorBrush}" BorderThickness="0,0,1,0">
            <Grid Padding="12,24,12,16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Configs" Style="{StaticResource PageTitle}" Margin="8,0,8,8" />
                        <TextBlock Text="Discover" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="8,8,8,4" />
                        <ListView x:Name="DiscoverPlaces" AutomationProperties.Name="Discover" TabNavigation="Once"
                                  SelectionChanged="OnDiscoverPlaceChanged" ItemContainerStyle="{StaticResource SidebarItem}">
                            <ListViewItem AccessKey="P" AutomationProperties.Name="Player Setups" Style="{StaticResource SidebarItem}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentPeopleCommunity}" FontSize="20" />
                                    <TextBlock Text="Player Setups" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem AccessKey="V" AutomationProperties.Name="Saved" Style="{StaticResource SidebarItem}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentBookmark}" FontSize="20" />
                                    <TextBlock Grid.Column="1" Text="Saved" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SavedCount" Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                               />
                                </Grid>
                            </ListViewItem>
                            <ListViewItem AutomationProperties.Name="Check a config" Style="{StaticResource SidebarItem}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentShieldCheckmark}" FontSize="20" />
                                    <TextBlock Text="Check a config" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListViewItem>
                        </ListView>
                        <TextBlock Text="My loadouts" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="8,12,8,4" />
                        <ListView x:Name="Loadouts" TabNavigation="Once" ItemContainerStyle="{StaticResource SidebarItem}"
                                  AutomationProperties.Name="My loadouts" SelectionChanged="OnSelectLoadout">
                            <ListView.Resources>
                                <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                            </ListView.Resources>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="52" ColumnSpacing="12" AutomationProperties.Name="{Binding Name}" Loaded="OnLoadoutRowLoaded" ActualThemeChanged="OnLoadoutRowThemeChanged">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource SelectionPill}" Margin="-12,0,0,0"
                                                Loaded="OnSelectionPillLoaded" />
                                        <Border x:Name="LoadoutTile" Style="{StaticResource InitialTile}">
                                            <TextBlock Text="{Binding Initial}" Style="{StaticResource LoadoutInitial}"
                                                       AutomationProperties.AccessibilityView="Raw" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="LoadoutStatus" Text="{Binding Status}" FontSize="12" />
                                        </StackPanel>
                                        <FontIcon x:Name="LoadoutCheck" Grid.Column="2" FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentCheck}" FontSize="16" Visibility="{Binding Checkmark}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button x:Name="NewLoadout" AccessKey="N" Click="OnNewLoadout" AutomationProperties.Name="New loadout"
                                Margin="0,4,0,0" Style="{StaticResource SidebarAction}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentAddSmall}" FontSize="16" />
                                <TextBlock Text="New loadout" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddConfig" AccessKey="I" AutomationProperties.Name="Add a config" Style="{StaticResource SidebarAction}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentArrowDownload}" FontSize="20" />
                                <TextBlock Text="Add a config" VerticalAlignment="Center" />
                                <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentChevronDown}" FontSize="12" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="From a file…" KeyboardAcceleratorTextOverride="Ctrl+O" Click="OnPickConfig" />
                                    <MenuFlyoutItem Text="From a link or GitHub…" Click="OnImportLink" />
                                    <MenuFlyoutItem Text="From this PC's server (localhost)…" Click="OnImportLocalhost" />
                                    <MenuFlyoutItem Text="From your Call of Duty 2 install…" Click="OnImportInstall" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Paste config" KeyboardAcceleratorTextOverride="Ctrl+Shift+V" Click="OnPasteConfig" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="1" Margin="8,0" FontSize="12" Style="{StaticResource SecondaryText}"
                           Text="Each loadout is its own Call of Duty 2 player profile, so the game sees exactly what you set here." />
            </Grid>
        </Border>
        <ScrollViewer x:Name="DetailScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="28,16,28,28" Spacing="12">
                <InfoBar x:Name="Status" IsClosable="True" />
                <InfoBar x:Name="ExportStatus" />
                <InfoBar x:Name="RecoveryStatus" IsClosable="False" Severity="Error" />
                <StackPanel x:Name="Detail" Spacing="8" />
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="ImportDropCue" Grid.ColumnSpan="2" Margin="12" IsHitTestVisible="False" Visibility="Collapsed">
            <Rectangle Stroke="{ThemeResource HeroAccentBrush}" StrokeThickness="2" StrokeDashArray="4,3"
                       RadiusX="8" RadiusY="8" />
            <Border Style="{StaticResource FieldCard}" Background="{ThemeResource PanelBrush}" Padding="16,10"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Drop to review this config" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </Border>
        </Grid>
    </Grid>
</Page>
