<Page x:Class="CoD2Unbound.Windows.Views.ConfigsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:core="using:CoD2Unbound.Core"
      xmlns:views="using:CoD2Unbound.Windows.Views">
    <Page.Resources>
        <DataTemplate x:Key="InstalledProfileHeader">
            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="10,8,0,4" />
        </DataTemplate>
        <DataTemplate x:Key="InstalledProfileRow">
            <StackPanel Spacing="3" Padding="8,6" AutomationProperties.Name="{Binding AccessibleName}">
                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="In use by the game" Style="{StaticResource PositiveCaption}" Visibility="{Binding ActiveVisibility}" />
                <TextBlock Text="Backup copy" Style="{StaticResource SecondaryText}" Visibility="{Binding BackupVisibility}" />
                <TextBlock Text="{Binding FileName}" Style="{StaticResource MonoCaption}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ShareLeftOutLine" x:DataType="core:ConfigShareLeftOut">
            <Grid ColumnSpacing="12" Padding="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="154" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Shown}" Style="{StaticResource MonoCaption}" TextWrapping="Wrap"
                           LineHeight="18" LineStackingStrategy="BlockLineHeight" />
                <TextBlock Grid.Column="1" Text="{x:Bind Because}" Style="{StaticResource SecondaryCaption}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="AdvancedBindRow">
            <Grid ColumnSpacing="12" AutomationProperties.Name="{Binding Title}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource StudioMonogramTile}">
                    <TextBlock Text="{Binding Key}" Style="{StaticResource MonoCaption}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryCaption}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="StudioHistoryRow">
            <Grid ColumnSpacing="16" Padding="0,10" AutomationProperties.Name="{Binding AccessibleName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource StudioMonogramTile}" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Initial}" Style="{StaticResource LoadoutInitial}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{ThemeResource ListRowSecondaryText}" />
                    <TextBlock Text="{Binding Stamp}" Style="{ThemeResource ListRowMonoCaption}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CheckerLine">
            <Border Padding="8,2" MinHeight="26" Loaded="OnCheckerLineLoaded" DataContextChanged="OnCheckerLineContextChanged"
                    ActualThemeChanged="OnCheckerLineThemeChanged" AutomationProperties.Name="{Binding AccessibleName}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Id}" Style="{StaticResource MonoCaption}" />
                    <TextBlock x:Name="LineMark" Grid.Column="1" Text="{Binding Icon}" />
                    <TextBlock x:Name="LineCode" Grid.Column="2" Text="{Binding Text}" Style="{StaticResource MonoCaption}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text}" />
                    <TextBlock x:Name="LineNote" Grid.Column="3" Text="{Binding Note}" Style="{StaticResource SecondaryCaption}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Note}" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CheckerFinding">
            <Grid ColumnSpacing="8" Padding="0,6" AutomationProperties.Name="{Binding AccessibleName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Line}" Style="{StaticResource MonoCaption}" Margin="0,3,0,0" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" />
                </StackPanel>
                <Button Grid.Column="2" Content="{Binding FixLabel}" Visibility="{Binding FixVisibility}"
                        AutomationProperties.Name="{Binding FixName}" Click="OnCheckerFix" />
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid x:Name="ConfigSurface" AllowDrop="True" Background="Transparent" Margin="20,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{ThemeResource SeparatorBrush}" BorderThickness="0,0,1,0">
            <Grid Padding="12,26,12,20" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Configs" Style="{StaticResource PageTitle}"
                           Margin="10,0,10,16" AutomationProperties.HeadingLevel="Level1" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Discover" Style="{StaticResource GroupLabelText}" Margin="10,0,10,6" />
                        <ListView x:Name="DiscoverPlaces" AutomationProperties.Name="Discover" TabNavigation="Once"
                                  SelectionChanged="OnDiscoverPlaceChanged">
                            <ListViewItem AccessKey="P" AutomationProperties.Name="Player Setups" Style="{StaticResource StudioColumnItem}">
                                <Grid ColumnDefinitions="30,*" ColumnSpacing="10" views:GlyphAlign.IsEnabled="True">
                                    <Border Style="{StaticResource StudioMonogramTile}" />
                                    <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentPeopleCommunity}"
                                              Width="30" FontSize="18" Foreground="{ThemeResource LinkBrush}" />
                                    <TextBlock Grid.Column="1" Text="Player Setups" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                            </ListViewItem>
                            <ListViewItem AccessKey="V" AutomationProperties.Name="Saved" Style="{StaticResource StudioColumnItem}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource StudioMonogramTile}" />
                                    <StackPanel Orientation="Horizontal" Spacing="10" views:GlyphAlign.IsEnabled="True">
                                        <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentBookmark}"
                                                  Width="30" FontSize="18" Foreground="{ThemeResource LinkBrush}" />
                                        <TextBlock Text="Saved" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="SavedCount" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </ListViewItem>
                            <ListViewItem AutomationProperties.Name="Check a config" AutomationProperties.AutomationId="ConfigsCheckConfig" Style="{StaticResource StudioColumnItem}">
                                <Grid ColumnDefinitions="30,*" ColumnSpacing="10" views:GlyphAlign.IsEnabled="True">
                                    <Border Style="{StaticResource StudioMonogramTile}" />
                                    <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentShieldCheckmark}"
                                              Width="30" FontSize="18" Foreground="{ThemeResource LinkBrush}" />
                                    <TextBlock Grid.Column="1" Text="Check a Config" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                            </ListViewItem>
                        </ListView>
                        <TextBlock Text="My loadouts" Style="{StaticResource GroupLabelText}" Margin="10,22,10,6" />
                        <ListView x:Name="Loadouts" TabNavigation="Once" ItemContainerStyle="{StaticResource StudioColumnItem}"
                                  AutomationProperties.Name="My loadouts" SelectionChanged="OnSelectLoadout"
                                  ContainerContentChanging="OnLoadoutContainerChanging">
                            <ListView.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Default">
                                            <Style x:Key="LoadoutStatusText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="HighContrast">
                                            <Style x:Key="LoadoutStatusText" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}" />
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </ListView.Resources>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource StudioMonogramTile}">
                                            <TextBlock Text="{Binding Initial}" Style="{StaticResource LoadoutInitial}"
                                                       Foreground="{ThemeResource LinkBrush}" AutomationProperties.AccessibilityView="Raw" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Status}" Style="{ThemeResource LoadoutStatusText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource StatusGlyphTile}" Visibility="{Binding Checkmark}"
                                                AutomationProperties.AccessibilityView="Raw">
                                            <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentCheck}"
                                                      FontSize="16" Style="{StaticResource PositiveIcon}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button x:Name="NewLoadout" AccessKey="N" Click="OnNewLoadout" AutomationProperties.Name="New loadout"
                                Style="{StaticResource StudioColumnAction}">
                            <Grid ColumnDefinitions="30,*" ColumnSpacing="10" views:GlyphAlign.IsEnabled="True">
                                <Border Style="{StaticResource StudioMonogramTile}" />
                                <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentAddSmall}" Width="30" FontSize="16" />
                                <TextBlock Grid.Column="1" Text="New Loadout" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </Button>
                        <Button x:Name="AddConfig" AccessKey="I" AutomationProperties.Name="Add a config" Style="{StaticResource StudioColumnAction}">
                            <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="10" views:GlyphAlign.IsEnabled="True">
                                <Border Style="{StaticResource StudioMonogramTile}" />
                                <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentArrowDownload}" Width="30" FontSize="18" />
                                <TextBlock Grid.Column="1" Text="Add a Config" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <FontIcon Grid.Column="2" FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentChevronDown}" FontSize="12" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="2" Margin="10,8,10,0" Style="{StaticResource SecondaryCaption}"
                           Text="Each loadout is its own Call of Duty 2 player profile, so the game sees exactly what you set here." />
            </Grid>
        </Border>
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Grid x:Name="ConfigToolbar" Margin="24,12,24,0" ColumnDefinitions="*,Auto" ColumnSpacing="8" />
            <ScrollViewer x:Name="DetailScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailColumn" Padding="24,16,24,24">
                    <InfoBar x:Name="Status" IsClosable="True" />
                    <InfoBar x:Name="ExportStatus" />
                    <InfoBar x:Name="RecoveryStatus" IsClosable="False" Severity="Error" />
                    <StackPanel x:Name="Detail" Spacing="8" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="ImportDropCue" Grid.ColumnSpan="2" Margin="12" IsHitTestVisible="False" Visibility="Collapsed">
            <Rectangle Stroke="{ThemeResource HeroAccentBrush}" StrokeThickness="2" StrokeDashArray="4,3"
                       RadiusX="8" RadiusY="8" />
            <Border Style="{StaticResource FieldCard}" Background="{ThemeResource PanelBrush}" Padding="16,10"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Drop to review this config" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </Border>
        </Grid>
    </Grid>
</Page>
