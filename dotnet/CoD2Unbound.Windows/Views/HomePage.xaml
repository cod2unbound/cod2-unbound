<Page x:Class="CoD2Unbound.Windows.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="OnLaunchShortcut" />
    </Page.KeyboardAccelerators>
    <ScrollViewer x:Name="Scroll" SizeChanged="OnLayoutChanged">
        <Grid>
            <Grid x:Name="ArtLayer" Height="520" VerticalAlignment="Top" IsHitTestVisible="False"
                  AutomationProperties.AccessibilityView="Raw">
                <Border x:Name="PanelPalette" Background="{ThemeResource PanelBrush}" />
                <Image x:Name="HeroArt" Stretch="UniformToFill" />
                <Rectangle x:Name="HeroScrim" />
                <Rectangle x:Name="HeroFade" />
            </Grid>
            <Grid x:Name="ContentLayout" Padding="48,64,48,32" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="Hero" HorizontalAlignment="Left" MaxWidth="768" Spacing="12" Padding="0,0,0,20"
                            Background="{ThemeResource HeroBackplateBrush}">
                    <TextBlock x:Name="HeroLead" Text="Ready to play" Foreground="{ThemeResource HeroAccentBrush}"
                               FontSize="15" FontWeight="SemiBold" CharacterSpacing="180" />
                    <TextBlock x:Name="HeroTitle" Text="COD2 UNBOUND" Foreground="{ThemeResource HeroInkBrush}"
                               FontFamily="ms-appx:///Assets/BigShouldersStencilDisplay.ttf#Big Shoulders Stencil Display"
                               FontSize="112" FontWeight="SemiBold" TextWrapping="Wrap"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Name="HeroDetail" MaxWidth="540" HorizontalAlignment="Left" FontSize="16"
                               TextWrapping="Wrap" Foreground="{ThemeResource HeroInkBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="LaunchButton" AutomationProperties.Name="Launch" AccessKey="L"
                                AutomationProperties.AcceleratorKey="Ctrl+Enter" Height="42" MinWidth="140"
                                Click="OnLaunch" Style="{StaticResource AccentButtonStyle}" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Play" />
                                <TextBlock Text="Launch" />
                            </StackPanel>
                        </Button>
                        <Button Height="42" AccessKey="F" Click="OnFindServer" AutomationProperties.Name="Find a server">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Globe" />
                                <TextBlock Text="Find a server" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="LaunchReason" Foreground="{ThemeResource HeroInkBrush}" TextWrapping="Wrap" />
                    <HyperlinkButton x:Name="OpenGameData" Content="Open Game Data" Click="OnOpenGameData"
                                     Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="LoadoutChoice" AutomationProperties.Name="Loadout"
                              AccessKey="O" IsEnabled="False" MinWidth="160" SelectionChanged="OnLoadoutChanged" />
                    <ComboBox x:Name="DisplayChoice" AutomationProperties.Name="Display mode"
                              AccessKey="D" MinWidth="128" SelectionChanged="OnDisplayChanged">
                        <ComboBoxItem Content="Borderless" Tag="borderless" />
                        <ComboBoxItem Content="Exclusive fullscreen" Tag="exclusive" />
                        <ComboBoxItem Content="Windowed" Tag="windowed" />
                    </ComboBox>
                </StackPanel>

                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource FieldCard}">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="Jump back in" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                <HyperlinkButton Content="All recent" HorizontalAlignment="Right" Click="OnRecent" />
                            </Grid>
                            <StackPanel x:Name="RecentRows" Spacing="8" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource FieldCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Last match" Style="{StaticResource CardTitle}" />
                            <StackPanel x:Name="MatchRows" Spacing="8" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource FieldCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="What’s New" Style="{StaticResource CardTitle}" />
                            <StackPanel x:Name="NewsRows" Spacing="8" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
