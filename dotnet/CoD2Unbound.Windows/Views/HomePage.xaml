<Page x:Class="CoD2Unbound.Windows.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:CoD2Unbound.Windows.Views">
    <ScrollViewer x:Name="Scroll" SizeChanged="OnLayoutChanged">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar x:Name="UpdateBanner" IsClosable="False" Margin="20,12,20,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="UpdateNotes" Content="What’s new" Click="OnUpdateNotes" />
                    <Button x:Name="UpdateButton" Click="OnUpdateAction" />
                </StackPanel>
            </InfoBar>
            <Grid Grid.Row="1" x:Name="ArtLayer" Height="520" VerticalAlignment="Top" IsHitTestVisible="False"
                  AutomationProperties.AccessibilityView="Raw">
                <Border x:Name="PanelPalette" Background="{ThemeResource PanelBrush}" />
                <Image x:Name="HeroArt" Stretch="UniformToFill" />
                <Rectangle x:Name="HeroScrim" />
                <Rectangle x:Name="HeroFade" />
            </Grid>
            <Grid Grid.Row="1" x:Name="ContentLayout" Padding="48,72,48,32" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="Hero" HorizontalAlignment="Left" MaxWidth="768" Spacing="16" Padding="0,0,0,4"
                            Background="{ThemeResource HeroBackplateBrush}">
                    <TextBlock x:Name="HeroLead" Text="READY TO PLAY" Style="{StaticResource HeroEyebrow}" />
                    <TextBlock x:Name="HeroTitle" Text="COD2 UNBOUND" Style="{StaticResource HeroTitle}" />
                    <TextBlock x:Name="HeroDetail" MaxWidth="540" HorizontalAlignment="Left" FontSize="16"
                               TextWrapping="Wrap" Foreground="{ThemeResource HeroInkBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <local:LaunchSplitButton x:Name="LaunchButton" AutomationProperties.Name="Launch" AccessKey="L"
                                AutomationProperties.AcceleratorKey="Ctrl+Enter" Height="40" MinWidth="140" CornerRadius="20"
                                Click="OnLaunchSplit" Visibility="Collapsed">
                            <local:LaunchSplitButton.Resources>
                                <ResourceDictionary Source="ms-appx:///Views/HomeLaunchResources.xaml" />
                            </local:LaunchSplitButton.Resources>
                            <local:LaunchSplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="RejoinMenu" Click="OnLaunch" KeyboardAcceleratorTextOverride="Ctrl+Enter">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource FluentFilled}" Glyph="{StaticResource FluentPlay}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Open the game menu" Click="OnOpenGameMenu" KeyboardAcceleratorTextOverride="Ctrl+Shift+Enter">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentPlayOutline}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Connect to an address…" Click="OnConnectAddress" KeyboardAcceleratorTextOverride="Ctrl+L">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentLive}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </local:LaunchSplitButton.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon FontFamily="{StaticResource FluentFilled}" Glyph="{StaticResource FluentPlay}" FontSize="16" />
                                <TextBlock Text="Launch" VerticalAlignment="Center" />
                            </StackPanel>
                        </local:LaunchSplitButton>
                        <Button x:Name="FindServerButton" Height="40" AccessKey="F" Click="OnFindServer" AutomationProperties.Name="Find a server">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentLive}" FontSize="16" />
                                <TextBlock Text="Find a server" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenGameMenuButton" Height="40" Click="OnOpenGameMenu"
                                AutomationProperties.Name="Open game menu" AutomationProperties.AcceleratorKey="Ctrl+Shift+Enter">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{StaticResource FluentFilled}" Glyph="{StaticResource FluentPlay}" FontSize="16" />
                                <TextBlock Text="Open game menu" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ReturnGameButton" Height="40" CornerRadius="20" Click="OnReturnGame"
                                Style="{StaticResource LauncherAccentButton}" Visibility="Collapsed"
                                AutomationProperties.Name="Return to game">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{StaticResource FluentFilled}" Glyph="{StaticResource FluentPlay}" FontSize="16" />
                                <TextBlock Text="Return to game" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CloseGameButton" Height="40" Click="OnCloseGame" Visibility="Collapsed"
                                AutomationProperties.Name="Close game">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7E8;" FontSize="16" />
                                <TextBlock x:Name="CloseGameLabel" Text="Close game" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="LaunchHint" Style="{StaticResource SecondaryText}" FontSize="12"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="LaunchReason" Foreground="{ThemeResource HeroInkBrush}" TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="LoadoutChoice" AutomationProperties.Name="Loadout"
                                  AccessKey="O" IsEnabled="False" MinWidth="160" SelectionChanged="OnLoadoutChanged" />
                        <DropDownButton x:Name="DisplayChoice" AutomationProperties.Name="Display mode" AccessKey="D" MinWidth="128">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <RadioMenuFlyoutItem x:Name="BorderlessMode" Text="Borderless" GroupName="DisplayMode"
                                                         Tag="borderless" Click="OnDisplayChanged" />
                                    <RadioMenuFlyoutItem x:Name="ExclusiveMode" Text="Exclusive fullscreen" GroupName="DisplayMode"
                                                         Tag="exclusive" Click="OnDisplayChanged" />
                                    <RadioMenuFlyoutItem x:Name="WindowMode" Text="Window" GroupName="DisplayMode"
                                                         Tag="windowed" Click="OnDisplayChanged" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button x:Name="NarrowNews" Content="What’s New" Click="OnShowNews" Visibility="Collapsed" />
                        <Button x:Name="AdjustedResolution" Visibility="Collapsed" Click="OnChooseResolution" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="OpenGameData" Click="OnOpenGameData" Visibility="Collapsed"
                                AutomationProperties.Name="Game data not found" />
                        <Button x:Name="OpenCdKey" Click="OnOpenCdKey" Visibility="Collapsed"
                                AutomationProperties.Name="No CD key" />
                    </StackPanel>
                </StackPanel>

                <Grid x:Name="Cards" Grid.Row="2" ColumnSpacing="12" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="NewsColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="RecentCard" Style="{StaticResource FieldCard}">
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="Jump back in" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                <HyperlinkButton Content="All recent" HorizontalAlignment="Right" Click="OnRecent" />
                            </Grid>
                            <StackPanel x:Name="RecentRows" Spacing="6" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="MatchCard" Grid.Column="1" Style="{StaticResource FieldCard}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock Text="Last match" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                <HyperlinkButton x:Name="AllMatches" Content="All matches" HorizontalAlignment="Right"
                                                 Click="OnAllMatches" Visibility="Collapsed" />
                            </Grid>
                            <StackPanel x:Name="MatchRows" Spacing="8" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="NewsCard" Grid.Column="2" Style="{StaticResource FieldCard}">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="What’s New" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                <HyperlinkButton Content="See all" HorizontalAlignment="Right" Click="OnShowNews" />
                            </Grid>
                            <StackPanel x:Name="NewsRows" Spacing="8" />
                            <TextBlock x:Name="NewsChecked" Style="{StaticResource SecondaryText}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
