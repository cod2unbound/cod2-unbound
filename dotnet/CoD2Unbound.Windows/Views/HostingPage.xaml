<Page x:Class="CoD2Unbound.Windows.Views.HostingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListView x:Name="Servers" DisplayMemberPath="Name" SelectionChanged="OnServerChanged"
                  AutomationProperties.Name="Hosted servers">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HighContrastAdjustment" Value="None" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Details" Spacing="12" />
        </ScrollViewer>
    </Grid>
</Page>
