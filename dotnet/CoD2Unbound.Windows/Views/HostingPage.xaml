<Page x:Class="CoD2Unbound.Windows.Views.HostingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Grid.ColumnSpan="2" Content="New server" Click="OnNew" AccessKey="N"
                HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" />
        <ListView x:Name="Servers" Grid.Row="1" DisplayMemberPath="Name" SelectionChanged="OnServerChanged"
                  AutomationProperties.Name="Hosted servers" />
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Details" Spacing="12" />
        </ScrollViewer>
    </Grid>
</Page>
