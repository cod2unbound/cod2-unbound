<Page x:Class="CoD2Unbound.Windows.Views.HostingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32,24" RowSpacing="12" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="Back to Servers" Click="OnServers" AccessKey="B" />
            <TextBlock Grid.Column="1" Text="Hosting" Style="{StaticResource PageTitle}" />
            <Button Grid.Column="2" Content="New server" Click="OnNew" AccessKey="N"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>
        <ListView x:Name="Servers" Grid.Row="1" DisplayMemberPath="Name" SelectionChanged="OnServerChanged"
                  AutomationProperties.Name="Hosted servers" />
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Details" Spacing="12" />
        </ScrollViewer>
    </Grid>
</Page>
