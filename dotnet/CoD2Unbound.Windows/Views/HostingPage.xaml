<Page x:Class="CoD2Unbound.Windows.Views.HostingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="HostingBody" Margin="40,8,32,24" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Sidebar" Style="{StaticResource GroupCard}" VerticalAlignment="Stretch" Width="300" Padding="12" AutomationProperties.Name="Your servers">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Your servers" Style="{StaticResource CaptionTextBlockStyle}" Margin="8,4,8,6" />
                <ListView x:Name="Servers" Grid.Row="1" SelectionChanged="OnServerChanged" ContainerContentChanging="OnServerRowChanged"
                          AutomationProperties.Name="Hosted servers">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource LauncherListViewItem}">
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <FontIcon x:Name="HostRowIcon" Glyph="{StaticResource FluentLive}" FontSize="16"
                                          FontFamily="{StaticResource FluentRegular}" AutomationProperties.AccessibilityView="Raw" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="HostRowStatus" Style="{ThemeResource ListRowSecondaryText}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="2" Text="Closing CoD2 Unbound asks before stopping a running server."
                           Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="8,4" />
            </Grid>
        </Border>
        <ScrollViewer Grid.Column="1" x:Name="DetailScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Details" Spacing="12" Margin="0,0,0,8" />
        </ScrollViewer>
    </Grid>
</Page>
