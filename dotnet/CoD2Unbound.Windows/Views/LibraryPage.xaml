<Page x:Class="CoD2Unbound.Windows.Views.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:views="using:CoD2Unbound.Windows.Views"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      PreviewKeyDown="OnLibraryKeyDown">
    <Page.Resources>
        <Style x:Key="LibraryListItem" TargetType="ListViewItem" BasedOn="{StaticResource LauncherListViewItem}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="80" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="LibraryColumnLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource tertiary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LibraryArt" TargetType="Border" BasedOn="{StaticResource MediaTile}">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="60" />
        </Style>
    </Page.Resources>
    <Grid x:Name="LibraryLayout" Padding="16,12,16,24" RowDefinitions="Auto,Auto,Auto,*">
        <Grid x:Name="LibraryToolbar" Margin="0,0,0,20" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Top">
            <SelectorBar x:Name="Sections"
                         VerticalAlignment="Center" SelectionChanged="OnSectionChanged"
                         AutomationProperties.Name="Library sections">
                <SelectorBarItem x:Name="MatchesSection" Text="Matches" AccessKey="M"
                                 AutomationProperties.AutomationId="MatchesSection" />
                <SelectorBarItem x:Name="DemosSection" AutomationProperties.AutomationId="DemosSection" Text="Demos" AccessKey="D" />
                <SelectorBarItem x:Name="ScreenshotsSection" AutomationProperties.AutomationId="ScreenshotsSection" Text="Screenshots" AccessKey="T" />
            </SelectorBar>
            <TextBox x:Name="Search" Grid.Column="1" Width="160" HorizontalAlignment="Right"
                     PlaceholderText="Find a file" TextChanged="OnSearch" PreviewKeyDown="OnSearchKeyDown" Visibility="Collapsed"
                     AutomationProperties.Name="Find a file"
                     AutomationProperties.AcceleratorKey="Ctrl+F" AccessKey="F" MaxLength="256" />
            <Button x:Name="DeleteSummaries" Grid.Column="2"
                    Click="OnDeleteSummaries" AccessKey="Y" AutomationProperties.Name="Delete summaries…"
                    ToolTipService.ToolTip="Delete the match summaries kept on this PC">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon FontFamily="{StaticResource SystemIcons}" Glyph="&#xE74D;" FontSize="16" />
                    <TextBlock Text="Delete Summaries…" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="ShowFolder" Grid.Column="2" Visibility="Collapsed"
                    Click="OnShowFolder" AccessKey="O" AutomationProperties.Name="Show in File Explorer">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentFolder}" FontSize="16" />
                    <TextBlock Text="Show in File Explorer" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="16,0,4,20">
            <StackPanel Spacing="6">
                <TextBlock x:Name="SectionTitle" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SectionDetail" Style="{StaticResource SecondaryText}" />
            </StackPanel>
            <StackPanel views:GlyphAlign.IsEnabled="True" x:Name="Retention" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentLock}"
                          FontSize="14" Foreground="{ThemeResource secondary}" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="RetentionText" Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2">
            <InfoBar x:Name="SummariesOff" IsClosable="False" Severity="Informational" Margin="0,0,0,14"
                     Message="Match summaries are off, so new matches aren’t added. These stay on this PC until you delete them.">
                <InfoBar.ActionButton>
                    <Button Content="Turn On in Settings…" Click="OnMatchPrivacy" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="RecycleNotice" Severity="Informational" CloseButtonClick="OnRecycleNoticeClosed" Margin="0,0,0,14">
                <InfoBar.ActionButton>
                    <Button Content="Undo" Click="OnUndoRecycle" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="Notice" Margin="0,0,0,14" />
        </StackPanel>
        <Grid Grid.Row="3">
            <ScrollViewer x:Name="Empty" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <ContentPresenter x:Name="EmptyBody" />
            </ScrollViewer>

            <Grid x:Name="MatchTable" RowDefinitions="Auto,*">
                <Grid Padding="10,0,22,8" ColumnSpacing="16" ColumnDefinitions="80,*,100,130,110">
                    <TextBlock Text="Map" Style="{StaticResource LibraryColumnLabel}" />
                    <TextBlock Grid.Column="1" Text="Match" Style="{StaticResource LibraryColumnLabel}" />
                    <TextBlock Grid.Column="2" Text="Ping" Style="{StaticResource LibraryColumnLabel}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="Connection" Style="{StaticResource LibraryColumnLabel}" HorizontalAlignment="Right" />
                </Grid>
                <ListView x:Name="Matches" Grid.Row="1" SelectionMode="None" TabNavigation="Once"
                          ItemContainerStyle="{StaticResource LibraryListItem}" AutomationProperties.Name="Match history">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="16" Padding="10,10,22,10" ColumnDefinitions="80,*,100,130,110">
                                <Border Style="{StaticResource LibraryArt}">
                                    <Image Stretch="UniformToFill" Loaded="OnMatchArtLoaded" DataContextChanged="OnMatchArtChanged"
                                           AutomationProperties.AccessibilityView="Raw" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                    <TextBlock Text="{Binding Title}" AutomationProperties.AutomationId="LibraryMatchTitle" TextTrimming="CharacterEllipsis"
                                               FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Stamp}" Style="{StaticResource Mono}" FontSize="12"
                                               Foreground="{ThemeResource secondary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" AutomationProperties.Name="{Binding PingName}">
                                    <TextBlock Text="{Binding Ping}" Style="{StaticResource Mono}" FontSize="16" FontWeight="Bold"
                                               Foreground="{ThemeResource heading}" VerticalAlignment="Bottom" />
                                    <TextBlock Text="ms" FontSize="12" Foreground="{ThemeResource tertiary}" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <StackPanel views:GlyphAlign.IsEnabled="True" Grid.Column="3" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center" HorizontalAlignment="Right" Loaded="OnConnectionLoaded"
                                            DataContextChanged="OnConnectionChanged" ActualThemeChanged="OnConnectionThemeChanged">
                                    <FontIcon FontFamily="{StaticResource SystemIcons}" FontSize="15" Glyph="{Binding ConnectionGlyph}"
                                              AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="{Binding ConnectionLabel}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="4" Content="Check-up" Tag="{Binding}" Click="OnMatchCheckup"
                                        AutomationProperties.Name="{Binding CheckupName}" ToolTipService.ToolTip="Open Check-up for this match"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid x:Name="ScreenshotGallery">
                <GridView x:Name="Screenshots" AutomationProperties.Name="Screenshots"
                          SelectionMode="Single" TabNavigation="Once" IsSwipeEnabled="False" VerticalAlignment="Top"
                          ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SizeChanged="OnScreenshotGridSizeChanged">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem" BasedOn="{StaticResource CrateItem}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,18,18" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="258" ItemHeight="236" Loaded="OnScreenshotPanelLoaded" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource panel}"
                                    BorderBrush="{ThemeResource panelStroke}" BorderThickness="{StaticResource Stroke}"
                                    AutomationProperties.Name="{Binding ScreenshotName}"
                                    DoubleTapped="OnMediaDoubleTapped" ContextRequested="OnMediaContextRequested">
                                <Grid RowDefinitions="*,Auto">
                                    <Border Background="{ThemeResource HeroBackplateBrush}">
                                        <Image Stretch="Uniform" Loaded="OnScreenshotLoaded" DataContextChanged="OnScreenshotChanged"
                                               AutomationProperties.AccessibilityView="Raw" />
                                    </Border>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="14,10">
                                        <TextBlock Text="{Binding ScreenshotTitle}" TextTrimming="CharacterEllipsis" FontSize="12"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Stamp}" Style="{StaticResource Mono}" FontSize="12"
                                                   Foreground="{ThemeResource secondary}" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                    <GridView.Footer>
                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Foreground="{ThemeResource tertiary}"
                                   Margin="6,0,18,0" Text="Double-click to open. Press Space to preview. Right-click for more actions." />
                    </GridView.Footer>
                </GridView>
            </Grid>

            <Grid x:Name="FileTable" RowDefinitions="Auto,*">
                <Grid Padding="10,0,22,8" ColumnSpacing="16" ColumnDefinitions="80,*,130,70,118">
                    <TextBlock Text="Map" Style="{StaticResource LibraryColumnLabel}" />
                    <TextBlock Grid.Column="1" Text="Recording" Style="{StaticResource LibraryColumnLabel}" />
                    <TextBlock Grid.Column="2" Text="Recorded" Style="{StaticResource LibraryColumnLabel}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="Size" Style="{StaticResource LibraryColumnLabel}" HorizontalAlignment="Right" />
                </Grid>
                <ListView x:Name="Files" Grid.Row="1" SelectionMode="Single" TabNavigation="Once" IsSwipeEnabled="False"
                          ItemContainerStyle="{StaticResource LibraryListItem}" AutomationProperties.Name="Files"
                          SelectionChanged="OnDemoSelectionChanged">
                    <ListView.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="HighContrast">
                                    <SolidColorBrush x:Key="SelectionTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                            <Style x:Key="DemoMenuAction" TargetType="Button" BasedOn="{StaticResource IconAction}">
                                <Setter Property="Foreground" Value="{ThemeResource heading}" />
                            </Style>
                            <Style x:Key="SelectedDemoMenuAction" TargetType="Button" BasedOn="{StaticResource DemoMenuAction}">
                                <Setter Property="Foreground" Value="{ThemeResource SelectionTextBrush}" />
                            </Style>
                        </ResourceDictionary>
                    </ListView.Resources>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10,10,22,10" ColumnSpacing="16" ColumnDefinitions="80,*,130,70,118"
                                  AutomationProperties.Name="{Binding DemoName}"
                                  DoubleTapped="OnMediaDoubleTapped" ContextRequested="OnMediaContextRequested">
                                <Border Style="{StaticResource LibraryArt}">
                                    <Image Stretch="UniformToFill" Loaded="OnDemoArtLoaded" DataContextChanged="OnDemoArtChanged"
                                           AutomationProperties.AccessibilityView="Raw" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{Binding DemoDetail}" TextTrimming="CharacterEllipsis" Style="{ThemeResource ListRowSecondaryText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Stamp}" Style="{ThemeResource ListRowMonoCaption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Size}" Style="{ThemeResource ListRowSecondaryText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <StackPanel x:Name="DemoActions" Grid.Column="4" Orientation="Horizontal" Spacing="16"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Click="OnPlayDemo" Tag="{Binding}" IsEnabled="{Binding CanPlay}"
                                            AutomationProperties.Name="{Binding PlayName}" AutomationProperties.HelpText="{Binding PlaybackHint}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource FluentFilled}" Glyph="{StaticResource FluentPlay}" FontSize="12" />
                                            <TextBlock Text="Play" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DemoMenuButton" Style="{StaticResource DemoMenuAction}" Click="OnFileMenu" Tag="{Binding}"
                                            Loaded="OnDemoMenuLoaded" DataContextChanged="OnDemoMenuContextChanged"
                                            AutomationProperties.Name="{Binding MenuName}" ToolTipService.ToolTip="More actions">
                                        <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentMore}" FontSize="17"
                                                  HighContrastAdjustment="None" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
