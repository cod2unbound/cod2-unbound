<Page x:Class="CoD2Unbound.Windows.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource GroundBrush}">
    <!-- The Settings window's body (SettingsWindow.swift): the pane bar under the title, a hairline, then the
         pane with the board's padding (20 top, 28 sides, 26 bottom). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <SelectorBar x:Name="Panes" Style="{StaticResource SettingsTabBar}" Margin="0,8" SelectionChanged="OnPaneChanged"
                     AutomationProperties.Name="Settings sections">
            <SelectorBarItem Text="General" AccessKey="G" Style="{StaticResource SettingsTabItem}" ToolTipService.ToolTip="General">
                <SelectorBarItem.Icon><FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentSettings}" FontSize="20" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Display" AccessKey="D" Style="{StaticResource SettingsTabItem}" ToolTipService.ToolTip="Display">
                <SelectorBarItem.Icon><FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentDesktop}" FontSize="20" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Game Data" AccessKey="F" Style="{StaticResource SettingsTabItem}" ToolTipService.ToolTip="Game Data">
                <SelectorBarItem.Icon><FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentFolder}" FontSize="20" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Privacy" AccessKey="I" Style="{StaticResource SettingsTabItem}" ToolTipService.ToolTip="Privacy">
                <SelectorBarItem.Icon><FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentLock}" FontSize="20" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Updates" AccessKey="U" Style="{StaticResource SettingsTabItem}" ToolTipService.ToolTip="Updates">
                <SelectorBarItem.Icon><FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentArrowDownload}" FontSize="20" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Advanced" AccessKey="A" Style="{StaticResource SettingsTabItem}" ToolTipService.ToolTip="Advanced">
                <SelectorBarItem.Icon><FontIcon FontFamily="{StaticResource SystemIcons}" Glyph="{StaticResource SystemSliders}" FontSize="19" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="About" AccessKey="B" Style="{StaticResource SettingsTabItem}" ToolTipService.ToolTip="About">
                <SelectorBarItem.Icon><FontIcon FontFamily="{StaticResource SystemIcons}" Glyph="{StaticResource SystemInfo}" FontSize="19" /></SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>
        <Border Grid.Row="1" Height="1" Background="{ThemeResource separator}" />
        <ScrollViewer x:Name="PaneScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PaneBody" Spacing="12" Padding="28,20,28,26">
                <InfoBar x:Name="Running" IsClosable="False" Severity="Informational"
                         Message="Call of Duty 2 is running. Changes you make here apply the next time it starts." />
                <InfoBar x:Name="Feedback" IsClosable="False" />
                <StackPanel x:Name="Fields" Spacing="4" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
