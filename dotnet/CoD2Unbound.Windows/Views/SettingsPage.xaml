<Page x:Class="CoD2Unbound.Windows.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="40,28,40,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
        <SelectorBar x:Name="Panes" Grid.Row="1" Style="{StaticResource AlignedSelector}" SelectionChanged="OnPaneChanged"
                     AutomationProperties.Name="Settings panes">
            <SelectorBarItem Text="General" AccessKey="G" />
            <SelectorBarItem Text="Display" AccessKey="D" />
            <SelectorBarItem Text="Game data" AccessKey="F" />
            <SelectorBarItem Text="Privacy" AccessKey="I" />
            <SelectorBarItem Text="Updates" AccessKey="U" />
            <SelectorBarItem Text="Advanced" AccessKey="A" />
            <SelectorBarItem Text="About" AccessKey="B" />
        </SelectorBar>
        <ScrollViewer x:Name="PaneScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Padding="0,0,0,24">
                <InfoBar x:Name="Feedback" IsClosable="False" />
                <StackPanel x:Name="Fields" Spacing="4" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
