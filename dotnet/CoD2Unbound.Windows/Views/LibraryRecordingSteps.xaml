<UserControl x:Class="CoD2Unbound.Windows.Views.LibraryRecordingSteps"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,8,0,0" Width="440">
    <UserControl.Resources>
        <Style x:Key="RecordingStep" TargetType="Grid" BasedOn="{StaticResource FormRow}">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="20,0" />
        </Style>
        <Style x:Key="StepNumber" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StepCommand" TargetType="Border" BasedOn="{StaticResource MediaTile}">
            <Setter Property="Height" Value="28" />
            <Setter Property="BorderThickness" Value="{StaticResource Stroke}" />
            <Setter Property="BorderBrush" Value="{ThemeResource buttonStroke}" />
            <Setter Property="Background" Value="{ThemeResource button}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StepCode" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="Foreground" Value="{ThemeResource chipText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource GroupCard}">
        <StackPanel>
            <Grid Style="{StaticResource RecordingStep}" ColumnDefinitions="16,Auto,Auto">
                <TextBlock Text="1" Style="{StaticResource StepNumber}" />
                <TextBlock Grid.Column="1" Text="In a match, open the console" VerticalAlignment="Center" />
                <Border Grid.Column="2" Style="{StaticResource StepCommand}">
                    <TextBlock Text="~" AutomationProperties.Name="The tilde key" Style="{StaticResource StepCode}" />
                </Border>
            </Grid>
            <Border Style="{StaticResource CardDivider}" Height="1" />
            <Grid Style="{StaticResource RecordingStep}" ColumnDefinitions="16,Auto,Auto">
                <TextBlock Text="2" Style="{StaticResource StepNumber}" />
                <TextBlock Grid.Column="1" Text="Start recording" VerticalAlignment="Center" />
                <Border Grid.Column="2" Style="{StaticResource StepCommand}">
                    <TextBlock Text="/record" Style="{StaticResource StepCode}" />
                </Border>
            </Grid>
            <Border Style="{StaticResource CardDivider}" Height="1" />
            <Grid Style="{StaticResource RecordingStep}" ColumnDefinitions="16,Auto,Auto">
                <TextBlock Text="3" Style="{StaticResource StepNumber}" />
                <TextBlock Grid.Column="1" Text="Stop when you’re done" VerticalAlignment="Center" />
                <Border Grid.Column="2" Style="{StaticResource StepCommand}">
                    <TextBlock Text="/stoprecord" Style="{StaticResource StepCode}" />
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
