<Window x:Class="CoD2Unbound.Windows.Fixtures.StylePartsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Launcher parts">
    <Grid x:Name="PartsRoot" Background="{ThemeResource ground}" RowDefinitions="32,*">
        <Grid x:Name="CaptionRegion" Background="Transparent" />
        <ScrollViewer Grid.Row="1" x:Name="PartsScroll" AutomationProperties.Name="Launcher parts">
            <StackPanel Padding="24" Spacing="22" MaxWidth="1040">
                <StackPanel Spacing="6">
                    <TextBlock Text="WINDOWS · SHARED PIECES" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="Launcher parts" Style="{StaticResource PageTitle}" />
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="Button sizes and roles" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Copy" Style="{StaticResource SmallAction}" />
                        <Button Content="Choose Folder…" />
                        <Button Content="Find a Server" Style="{StaticResource MediumButton}" />
                        <Button Content="Launch" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Open CoD2 Unbound" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Back" />
                        <Button Content="See What’s Sent…" Style="{StaticResource QuietButton}" />
                        <Button Content="Delete Loadout…" Style="{StaticResource NegativeButton}" />
                        <Button Content="Continue" IsEnabled="False" />
                        <Button Content="Continue" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                        <Button Style="{StaticResource IconAction}" ToolTipService.ToolTip="Refresh"
                                AutomationProperties.Name="Refresh">
                            <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentRefresh}" FontSize="16" />
                        </Button>
                    </StackPanel>
                    <HyperlinkButton Content="Full Release Notes" />
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="Fields and choices" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox Width="136" Text="Morrow" AutomationProperties.Name="Inline name" />
                        <TextBox Width="160" Text="Morrow" Style="{StaticResource InlineTextBox}" AutomationProperties.Name="Player name" />
                        <PasswordBox Width="178" Password="000000000000000086D3" Style="{StaticResource InlinePasswordBox}"
                                     AutomationProperties.Name="CD key" />
                        <NumberBox Width="120" Value="24" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Slots" />
                    </StackPanel>
                    <AutoSuggestBox PlaceholderText="Search players, teams or styles" AutomationProperties.Name="Search players, teams or styles"
                                    TextBoxStyle="{StaticResource SearchField}" Width="280" HorizontalAlignment="Left">
                        <AutoSuggestBox.QueryIcon><SymbolIcon Symbol="Find" /></AutoSuggestBox.QueryIcon>
                    </AutoSuggestBox>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <SelectorBar>
                            <SelectorBarItem Text="Guided" IsSelected="True" />
                            <SelectorBarItem Text="Expert" />
                        </SelectorBar>
                        <SelectorBar Style="{StaticResource SegmentedLarge}" AutomationProperties.Name="Large segmented">
                            <SelectorBarItem Text="Guided" IsSelected="True" Style="{StaticResource SegmentLargeItem}" />
                            <SelectorBarItem Text="Expert" Style="{StaticResource SegmentLargeItem}" />
                        </SelectorBar>
                        <ComboBox SelectedIndex="0" AutomationProperties.Name="Edition">
                            <ComboBoxItem Content="CoD2x 1.4.6.8" />
                            <ComboBoxItem Content="Original 1.3" />
                        </ComboBox>
                        <ToggleSwitch AutomationProperties.Name="Refresh on open" IsOn="True" />
                        <ToggleSwitch AutomationProperties.Name="Show empty servers" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <CheckBox Content="Team Deathmatch" IsChecked="True" />
                        <RadioButton Content="Original 1.3" GroupName="Edition" IsChecked="True" />
                        <RadioButton Content="CoD2x 1.4.6.8" GroupName="Edition" />
                        <Slider Width="112" Value="38" AutomationProperties.Name="Brightness" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressBar Width="232" Value="64" VerticalAlignment="Center" AutomationProperties.Name="Download progress" />
                        <ProgressRing Width="24" Height="24" IsActive="True" AutomationProperties.Name="Checking" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="Chips, badges and states" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="CoD2x 1.4.6.8" Style="{StaticResource ChipButton}" />
                        <Button Content="Borderless" Style="{StaticResource ChipButton}" />
                        <Button Content="Main loadout · 2560 × 1440" Style="{StaticResource LargeChipButton}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource EditionTag}"><TextBlock Text="Original 1.3" Style="{StaticResource CaptionTextBlockStyle}" /></Border>
                        <Border Style="{StaticResource Cod2xTag}"><TextBlock Text="zPAM 3" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource accent}" /></Border>
                        <Border Style="{StaticResource EditionTag}" BorderBrush="{ThemeResource negative}"><TextBlock Text="Breaks zPAM" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource negative}" /></Border>
                        <Border Style="{StaticResource EditionTag}"><TextBlock Text="Recommended" Style="{StaticResource CaptionTextBlockStyle}" /></Border>
                        <TextBlock Text="✓ Verified" Foreground="{ThemeResource positive}" />
                        <TextBlock Text="Some dips" Foreground="{ThemeResource caution}" />
                        <TextBlock Text="Missing" Foreground="{ThemeResource negative}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="Groups, rows, banners and choice cards" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <Grid Style="{StaticResource FormRow}" ColumnDefinitions="Auto,*,Auto">
                                <Border Style="{StaticResource RowSymbol}">
                                    <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentFolder}" FontSize="16" Foreground="{ThemeResource accent}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Game data" Style="{StaticResource BodyTextBlockStyle}" />
                                    <TextBlock Text="Version 1.3 · Installed on this PC" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource tertiary}" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Change…" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource separator}" />
                            <Grid Style="{StaticResource FormRow}" ColumnDefinitions="*,Auto">
                                <TextBlock Text="Refresh the server list when Servers opens" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" AutomationProperties.Name="Refresh the server list when Servers opens" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <InfoBar IsOpen="True" Message="Mouse, brightness, network, HUD and sound live in your loadouts." IsClosable="False">
                        <InfoBar.ActionButton><Button Content="Open Configs" Style="{StaticResource QuietButton}" /></InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar IsOpen="True" Severity="Error" Message="This folder is missing main\iw_04.iwd and 11 more game archives." IsClosable="False" />
                    <InfoBar IsOpen="True" Severity="Warning" Message="Check these settings before launching." IsClosable="False" />
                    <InfoBar IsOpen="True" Severity="Success" Message="Saved. Applies the next time the game starts." IsClosable="False" />
                    <GridView SelectedIndex="0" ItemContainerStyle="{StaticResource CrateItem}" AutomationProperties.Name="Sensitivity presets">
                        <GridViewItem Content="1.4 · Low sensitivity, steady rifle" Padding="12" />
                        <GridViewItem Content="5.0 · Fast turns, clean screen" Padding="12" />
                        <GridViewItem Content="0.8 · Scoped rifle, quiet HUD" Padding="12" />
                    </GridView>
                    <ListView SelectedIndex="0" AutomationProperties.Name="Favorite servers" MaxHeight="132">
                        <ListViewItem Content="Northern Lights · 18/24" />
                        <ListViewItem Content="Desert Fox SD · 12/20" />
                    </ListView>
                    <Expander Header="Show the lines"><TextBlock Text="seta sensitivity 1.4" Style="{StaticResource Mono}" /></Expander>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="Glass on art" Style="{StaticResource SectionTitle}" />
                    <Grid MinHeight="180" ColumnDefinitions="*,*" ColumnSpacing="20" Padding="20">
                        <Grid.Background>
                            <ImageBrush Stretch="UniformToFill">
                                <ImageBrush.ImageSource><SvgImageSource UriSource="ms-appx:///Assets/hero-dark.svg" /></ImageBrush.ImageSource>
                            </ImageBrush>
                        </Grid.Background>
                        <Border CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="20"
                                Background="{ThemeResource PanelBrush}" BorderBrush="{ThemeResource glassStroke}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Panel on the art" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="This PC’s glass" Style="{StaticResource SecondaryText}" />
                                <Button Content="Back" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="20"
                                Background="{ThemeResource PanelBrush}" BorderBrush="{ThemeResource glassStroke}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Panel on the art" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Opaque glass" Style="{StaticResource SecondaryText}" />
                                <Button Content="Continue" Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="Sidebar" Style="{StaticResource SectionTitle}" />
                    <Border CornerRadius="{ThemeResource OverlayCornerRadius}" Width="232"
                            HorizontalAlignment="Left" Background="{ThemeResource PanelBrush}"
                            BorderBrush="{ThemeResource glassStroke}" BorderThickness="1"
                            Padding="0,10,0,8">
                        <NavigationView x:Name="SampleSidebar" PaneDisplayMode="Left" IsPaneOpen="True"
                                        IsTitleBarAutoPaddingEnabled="False" IsBackButtonVisible="Collapsed"
                                        IsSettingsVisible="False" OpenPaneLength="230" Height="390">
                            <NavigationView.PaneHeader>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Width="29" Height="29" Source="ms-appx:///Assets/mark-48.png" />
                                    <Image x:Name="SampleWordmark" Width="110" Height="16" />
                                </StackPanel>
                            </NavigationView.PaneHeader>
                            <NavigationView.MenuItems>
                                <NavigationViewItem Content="Home" IsSelected="True">
                                    <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentHome}" FontSize="18" /></NavigationViewItem.Icon>
                                </NavigationViewItem>
                                <NavigationViewItem Content="Servers">
                                    <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentLive}" FontSize="18" /></NavigationViewItem.Icon>
                                </NavigationViewItem>
                                <NavigationViewItem Content="Library">
                                    <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentFilmstrip}" FontSize="18" /></NavigationViewItem.Icon>
                                </NavigationViewItem>
                                <NavigationViewItem Content="Configs">
                                    <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentStack}" FontSize="18" /></NavigationViewItem.Icon>
                                </NavigationViewItem>
                                <NavigationViewItemHeader Content="Favorites" />
                                <NavigationViewItem Content="Northern Lights · 18/24">
                                    <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource FluentFilled}" Glyph="{StaticResource FluentStarFilled}" FontSize="16" /></NavigationViewItem.Icon>
                                </NavigationViewItem>
                                <NavigationViewItem Content="Desert Fox SD · 12/20">
                                    <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource FluentFilled}" Glyph="{StaticResource FluentStarFilled}" FontSize="16" /></NavigationViewItem.Icon>
                                </NavigationViewItem>
                            </NavigationView.MenuItems>
                            <NavigationView.PaneFooter>
                                <StackPanel>
                                    <Button AutomationProperties.Name="Sample settings entry">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentSettings}" FontSize="18" />
                                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Border Height="1" Margin="16,6,16,0" Background="{ThemeResource separator}" />
                                    <Button Margin="12,8,12,8"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            AutomationProperties.Name="Open your player card">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <ContentControl Style="{StaticResource MiniDogTag}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Sgt. Morrow" FontWeight="SemiBold" />
                                                <TextBlock Text="Main loadout" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource secondary}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </NavigationView.PaneFooter>
                        </NavigationView>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="Sheets, popovers and menus" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Open Sheet" Click="OpenSheet" />
                        <Button Content="Open Alert" Click="OpenAlert" />
                        <Button Content="Open Popover">
                            <Button.Flyout>
                                <Flyout><TextBlock Text="Each loadout is its own Call of Duty 2 player profile." /></Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Content="Open Menu">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Launch" KeyboardAcceleratorTextOverride="Ctrl+Enter" />
                                    <MenuFlyoutItem Text="Copy Address" KeyboardAcceleratorTextOverride="Ctrl+Shift+C" />
                                    <MenuFlyoutItem Text="Add to Favorites" KeyboardAcceleratorTextOverride="Ctrl+D" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Remove from Recent" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Typography" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="EYEBROW" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="STENCIL TITLE" Style="{StaticResource EmptyHeading}" />
                    <TextBlock Text="Page title" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Section title" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Panel title" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Card title" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Body" Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Text="Subtitle" Style="{StaticResource SecondaryText}" />
                    <TextBlock Text="Help" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource tertiary}" />
                    <TextBlock Text="203.0.113.24:28960" Style="{StaticResource AddressText}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
