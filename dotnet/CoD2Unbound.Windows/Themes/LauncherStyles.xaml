<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="StencilExtraBold">ms-appx:///Assets/BigShouldersStencilDisplay-ExtraBold.ttf#Big Shoulders Stencil Display ExtraBold</FontFamily>
    <FontFamily x:Key="StencilBold">ms-appx:///Assets/BigShouldersStencilDisplay-Bold.ttf#Big Shoulders Stencil Display</FontFamily>
    <FontFamily x:Key="CourierPrime">ms-appx:///Assets/CourierPrime-Regular.ttf#Courier Prime</FontFamily>

    <!-- Fluent UI System Icons from Microsoft, 6c2c9075cf89 (MIT). -->
    <FontFamily x:Key="FluentRegular">ms-appx:///Assets/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular</FontFamily>
    <x:String x:Key="FluentHome">&#xF480;</x:String>
    <x:String x:Key="FluentLive">&#xF4F0;</x:String>
    <x:String x:Key="FluentVideoClip">&#xEDFF;</x:String>
    <x:String x:Key="FluentStack">&#xF792;</x:String>
    <x:String x:Key="FluentSettings">&#xF6A9;</x:String>
    <x:String x:Key="FluentAdd">&#xF109;</x:String>
    <x:String x:Key="FluentAddSmall">&#xF108;</x:String>
    <x:String x:Key="FluentSearch">&#xF68F;</x:String>
    <x:String x:Key="FluentFilter">&#xF406;</x:String>
    <x:String x:Key="FluentBookmark">&#xF1F5;</x:String>
    <x:String x:Key="FluentCopy">&#xF32B;</x:String>
    <x:String x:Key="FluentRefresh">&#xF13D;</x:String>
    <x:String x:Key="FluentDesktop">&#xF359;</x:String>
    <x:String x:Key="FluentCheck">&#xE305;</x:String>
    <x:String x:Key="FluentCheckCircle">&#xF297;</x:String>
    <x:String x:Key="FluentChevronDown">&#xF2A2;</x:String>
    <x:String x:Key="FluentChevronUp">&#xF2B5;</x:String>
    <x:String x:Key="FluentChevronRight">&#xF2AF;</x:String>
    <x:String x:Key="FluentPerson">&#xF5BD;</x:String>
    <x:String x:Key="FluentHistory">&#xE707;</x:String>
    <x:String x:Key="FluentClipboardCheck">&#xE35E;</x:String>
    <x:String x:Key="FluentFolder">&#xF418;</x:String>
    <x:String x:Key="FluentDocumentAdd">&#xE4DA;</x:String>
    <x:String x:Key="FluentDocument">&#xF378;</x:String>
    <x:String x:Key="FluentStar">&#xF70F;</x:String>
    <x:String x:Key="FluentLock">&#xE78E;</x:String>
    <x:String x:Key="FluentTag">&#xEC70;</x:String>
    <x:String x:Key="FluentMore">&#xE824;</x:String>
    <x:String x:Key="FluentImage">&#xF489;</x:String>
    <x:String x:Key="FluentHeartPulse">&#xE701;</x:String>
    <FontFamily x:Key="FluentFilled">ms-appx:///Assets/FluentSystemIcons-Filled.ttf#FluentSystemIcons-Filled</FontFamily>
    <x:String x:Key="FluentPlay">&#xE9A2;</x:String>
    <x:String x:Key="FluentStarFilled">&#xF718;</x:String>

    <Style x:Key="LauncherAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="HighContrastAdjustment" Value="None" />
    </Style>

    <Style x:Key="HeroTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StencilExtraBold}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="132" />
        <Setter Property="LineHeight" Value="113.52" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <!-- The font's ink rises above the shortened line box. -->
        <Setter Property="Margin" Value="0,24,0,-24" />
        <Setter Property="CharacterSpacing" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource HeroInkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
    </Style>
    <Style x:Key="StencilText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StencilBold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource HeroAccentBrush}" />
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CourierPrime}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextLineBounds" Value="Tight" />
    </Style>
    <Style x:Key="MonoCaption" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
        <Setter Property="Foreground" Value="{ThemeResource TertiaryBrush}" />
    </Style>
    <Style x:Key="AddressText" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
        <Setter Property="Foreground" Value="{ThemeResource AddressBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="MonoField" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource CourierPrime}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource HeadingBrush}" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource HeadingBrush}" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{ThemeResource HeadingBrush}" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>
    <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource CaptionBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="PositiveCaption" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
        <Setter Property="Foreground" Value="{ThemeResource PositiveBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="PositiveIcon" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource PositiveBrush}" />
    </Style>
    <Style x:Key="NegativeText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
        <Setter Property="Foreground" Value="{ThemeResource NegativeBrush}" />
    </Style>
    <Style x:Key="NegativeButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource NegativeBrush}" />
    </Style>
    <Style x:Key="ColumnHeading" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource CaptionBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="0,0,8,0" />
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource StencilText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="200" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="HeroEyebrow" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CharacterSpacing" Value="340" />
    </Style>
    <Style x:Key="EmptyIcon" TargetType="FontIcon">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="Foreground" Value="{ThemeResource TertiaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
    </Style>
    <Style x:Key="EmptyHeading" TargetType="TextBlock" BasedOn="{StaticResource StencilText}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="Foreground" Value="{ThemeResource ChipIconBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>
    <Style x:Key="SelectionPill" TargetType="Border">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="16" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{ThemeResource ListViewItemSelectionIndicatorBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>
    <Style x:Key="SidebarItem" TargetType="ListViewItem">
        <Setter Property="HighContrastAdjustment" Value="None" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,0,12,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="SidebarAction" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="16,0,12,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{ThemeResource LinkBrush}" />
    </Style>
    <Style x:Key="InitialTile" TargetType="Border">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="{ThemeResource ControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style x:Key="LoadoutInitial" TargetType="TextBlock" BasedOn="{StaticResource StencilText}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="MediaTile" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillBrush}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style x:Key="SmallAction" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,3" />
    </Style>
    <Style x:Key="IconAction" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="EditionTag" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeBrush}" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style x:Key="Cod2xTag" TargetType="Border" BasedOn="{StaticResource EditionTag}">
        <Setter Property="BorderBrush" Value="{ThemeResource EditionStrokeBrush}" />
    </Style>
    <Style x:Key="AlignedSelector" TargetType="SelectorBar">
        <Setter Property="Margin" Value="-12,0,0,0" />
    </Style>
    <Style x:Key="Keycap" TargetType="Button" BasedOn="{StaticResource SmallAction}">
        <Setter Property="FontFamily" Value="{StaticResource CourierPrime}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{ThemeResource ControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeBrush}" />
    </Style>
    <Style x:Key="AddKeycap" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource LinkBrush}" />
    </Style>
    <Style x:Key="SetupHeroFooter" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FieldBrush}" />
        <Setter Property="Padding" Value="12,8,12,10" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="CornerRadius" Value="0,0,4,4" />
    </Style>
    <Style x:Key="CardDivider" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SeparatorBrush}" />
    </Style>
    <Style x:Key="FieldCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FieldBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="ReviewRow" TargetType="Border" BasedOn="{StaticResource FieldCard}">
        <Setter Property="Padding" Value="12,8" />
    </Style>
</ResourceDictionary>
