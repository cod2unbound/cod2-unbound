        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleSwitch">
                    <StackPanel>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="OuterBorder.Fill" Value="{ThemeResource ToggleSwitchFillOffPointerOver}" />
                                        <Setter Target="SwitchKnobBounds.Fill" Value="{ThemeResource ToggleSwitchFillOnPointerOver}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="OuterBorder.Fill" Value="{ThemeResource ToggleSwitchFillOffPressed}" />
                                        <Setter Target="SwitchKnobBounds.Fill" Value="{ThemeResource ToggleSwitchFillOnPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="OuterBorder.Fill" Value="{ThemeResource ToggleSwitchFillOffDisabled}" />
                                        <Setter Target="SwitchKnobBounds.Fill" Value="{ThemeResource ToggleSwitchFillOnDisabled}" />
                                        <Setter Target="KnobFace.Fill" Value="{ThemeResource disabledInk}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ToggleStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition x:Name="OffToOnTransition" From="Off" To="On">
                                        <Storyboard><RepositionThemeAnimation TargetName="SwitchKnob"
                                            FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobOffToOnOffset}" /></Storyboard>
                                    </VisualTransition>
                                    <VisualTransition x:Name="OnToOffTransition" From="On" To="Off">
                                        <Storyboard><RepositionThemeAnimation TargetName="SwitchKnob"
                                            FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobOnToOffOffset}" /></Storyboard>
                                    </VisualTransition>
                                    <VisualTransition x:Name="DraggingToOnTransition" From="Dragging" To="On">
                                        <Storyboard><RepositionThemeAnimation TargetName="SwitchKnob"
                                            FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobCurrentToOnOffset}" /></Storyboard>
                                    </VisualTransition>
                                    <VisualTransition x:Name="DraggingToOffTransition" From="Dragging" To="Off">
                                        <Storyboard><RepositionThemeAnimation TargetName="SwitchKnob"
                                            FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobCurrentToOffOffset}" /></Storyboard>
                                    </VisualTransition>
                                    <VisualTransition x:Name="OnToDraggingTransition" From="On" To="Dragging" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Dragging" />
                                <VisualState x:Name="Off" />
                                <VisualState x:Name="On">
                                    <VisualState.Setters>
                                        <Setter Target="KnobTranslateTransform.X" Value="{StaticResource SwitchTravel}" />
                                        <Setter Target="SwitchKnobBounds.Opacity" Value="1" />
                                        <Setter Target="OuterBorder.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="HeaderContentPresenter" Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}" />
                        <Grid Width="{StaticResource SwitchWidth}" Height="{StaticResource SwitchHeight}"
                              HorizontalAlignment="Left" x:Name="SwitchAreaGrid" Control.IsTemplateFocusTarget="True"
                              CornerRadius="{StaticResource SwitchRadius}">
                            <Rectangle x:Name="OuterBorder" RadiusX="12" RadiusY="12" Fill="{ThemeResource ToggleSwitchFillOff}"
                                       Stroke="{ThemeResource ToggleSwitchStrokeOff}" StrokeThickness="1" />
                            <Rectangle x:Name="SwitchKnobBounds" RadiusX="12" RadiusY="12" Opacity="0"
                                       Fill="{ThemeResource ToggleSwitchFillOn}" />
                            <Grid x:Name="SwitchKnob" Width="{StaticResource SwitchHeight}" HorizontalAlignment="Left">
                                <Grid.RenderTransform><TranslateTransform x:Name="KnobTranslateTransform" /></Grid.RenderTransform>
                                <Ellipse x:Name="KnobFace" Width="{StaticResource SwitchKnobSize}" Height="{StaticResource SwitchKnobSize}"
                                         Fill="{ThemeResource ToggleSwitchKnobFillOff}" />
                            </Grid>
                            <Thumb x:Name="SwitchThumb" AutomationProperties.AccessibilityView="Raw">
                                <Thumb.Template><ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent" /></ControlTemplate></Thumb.Template>
                            </Thumb>
                        </Grid>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
