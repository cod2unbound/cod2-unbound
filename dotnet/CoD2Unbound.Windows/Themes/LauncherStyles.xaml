    <Style TargetType="SelectorBarItem" BasedOn="{StaticResource DefaultSelectorBarItemStyle}">
        <Setter Property="Foreground" Value="{ThemeResource secondary}" />
        <Setter Property="CornerRadius" Value="{StaticResource CapsuleRadius}" />
        <Setter Property="FontSize" Value="{StaticResource HelpSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusVisualPrimaryBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource FocusStroke}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualMargin" Value="{StaticResource FocusMargin}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="SelectorBarItem">
                    <Grid x:Name="PART_ContainerRoot" CornerRadius="{TemplateBinding CornerRadius}"
                          Background="Transparent" MinHeight="{TemplateBinding MinHeight}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CombinedStates">
                                <VisualState x:Name="UnselectedNormal" />
                                <VisualState x:Name="UnselectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ContainerRoot.Background" Value="{ThemeResource SelectorBarItemBackgroundPointerOver}" />
                                        <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundPointerOver}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="UnselectedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ContainerRoot.Background" Value="{ThemeResource SelectorBarItemBackgroundPressed}" />
                                        <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedNormal">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ContainerRoot.Background" Value="{ThemeResource SelectorBarItemBackgroundSelected}" />
                                        <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundSelected}" />
                                        <Setter Target="PART_IconVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundSelected}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ContainerRoot.Background" Value="{ThemeResource SelectorBarItemBackgroundSelectedPointerOver}" />
                                        <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundSelected}" />
                                        <Setter Target="PART_IconVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundSelected}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ContainerRoot.Background" Value="{ThemeResource SelectorBarItemBackgroundSelectedPressed}" />
                                        <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundSelected}" />
                                        <Setter Target="PART_IconVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundSelected}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DisabledStates">
                                <VisualState x:Name="Enabled" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource disabledInk}" />
                                        <Setter Target="PART_IconVisual.Foreground" Value="{ThemeResource disabledInk}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Child}" />
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                            <ContentPresenter x:Name="PART_IconVisual" Content="{TemplateBinding Icon}" Foreground="{TemplateBinding Foreground}" />
                            <TextBlock x:Name="PART_TextVisual" Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Segmented" TargetType="SelectorBar" BasedOn="{StaticResource DefaultSelectorBarStyle}">
        <Setter Property="Padding" Value="2" />
        <Setter Property="CornerRadius" Value="{StaticResource CapsuleRadius}" />
        <Setter Property="Background" Value="{ThemeResource well}" />
        <Setter Property="BorderBrush" Value="{ThemeResource wellStroke}" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="{StaticResource SegmentHeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="SelectorBar">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <ItemsView x:Name="PART_ItemsView" ItemsSource="{TemplateBinding Items}"
                                   TabNavigation="{TemplateBinding TabNavigation}" Padding="{TemplateBinding Padding}"
                                   MaxWidth="{TemplateBinding MaxWidth}" MaxHeight="{TemplateBinding MaxHeight}">
                            <ItemsView.Layout><StackLayout Orientation="Horizontal" /></ItemsView.Layout>
                        </ItemsView>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="SelectorBar" BasedOn="{StaticResource Segmented}" />
    <Style TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="MinWidth" Value="{StaticResource SwitchWidth}" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusVisualPrimaryBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource FocusStroke}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualMargin" Value="{StaticResource FocusMargin}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleSwitch">
                    <StackPanel>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="OuterBorder.Fill" Value="{ThemeResource ToggleSwitchFillOffPointerOver}" />
                                        <Setter Target="SwitchKnobBounds.Fill" Value="{ThemeResource ToggleSwitchFillOnPointerOver}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="OuterBorder.Fill" Value="{ThemeResource ToggleSwitchFillOffPressed}" />
                                        <Setter Target="SwitchKnobBounds.Fill" Value="{ThemeResource ToggleSwitchFillOnPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="OuterBorder.Fill" Value="{ThemeResource ToggleSwitchFillOffDisabled}" />
                                        <Setter Target="SwitchKnobBounds.Fill" Value="{ThemeResource ToggleSwitchFillOnDisabled}" />
                                        <Setter Target="KnobFace.Fill" Value="{ThemeResource disabledInk}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ToggleStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition x:Name="OffToOnTransition" From="Off" To="On">
                                        <Storyboard><RepositionThemeAnimation TargetName="SwitchKnob"
                                            FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobOffToOnOffset}" /></Storyboard>
                                    </VisualTransition>
                                    <VisualTransition x:Name="OnToOffTransition" From="On" To="Off">
                                        <Storyboard><RepositionThemeAnimation TargetName="SwitchKnob"
                                            FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobOnToOffOffset}" /></Storyboard>
                                    </VisualTransition>
                                    <VisualTransition x:Name="DraggingToOnTransition" From="Dragging" To="On">
                                        <Storyboard><RepositionThemeAnimation TargetName="SwitchKnob"
                                            FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobCurrentToOnOffset}" /></Storyboard>
                                    </VisualTransition>
                                    <VisualTransition x:Name="DraggingToOffTransition" From="Dragging" To="Off">
                                        <Storyboard><RepositionThemeAnimation TargetName="SwitchKnob"
                                            FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobCurrentToOffOffset}" /></Storyboard>
                                    </VisualTransition>
                                    <VisualTransition x:Name="OnToDraggingTransition" From="On" To="Dragging" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Dragging" />
                                <VisualState x:Name="Off" />
                                <VisualState x:Name="On">
                                    <VisualState.Setters>
                                        <Setter Target="KnobTranslateTransform.X" Value="{StaticResource SwitchTravel}" />
                                        <Setter Target="SwitchKnobBounds.Opacity" Value="1" />
                                        <Setter Target="OuterBorder.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="HeaderContentPresenter" Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}" />
                        <Grid Width="{StaticResource SwitchWidth}" Height="{StaticResource SwitchHeight}"
                              HorizontalAlignment="Left" x:Name="SwitchAreaGrid" Control.IsTemplateFocusTarget="True"
                              CornerRadius="{StaticResource CapsuleRadius}">
                            <Rectangle x:Name="OuterBorder" RadiusX="12" RadiusY="12" Fill="{ThemeResource ToggleSwitchFillOff}"
                                       Stroke="{ThemeResource ToggleSwitchStrokeOff}" StrokeThickness="1" />
                            <Rectangle x:Name="SwitchKnobBounds" RadiusX="12" RadiusY="12" Opacity="0"
                                       Fill="{ThemeResource ToggleSwitchFillOn}" />
                            <Grid x:Name="SwitchKnob" Width="{StaticResource SwitchHeight}" HorizontalAlignment="Left">
                                <Grid.RenderTransform><TranslateTransform x:Name="KnobTranslateTransform" /></Grid.RenderTransform>
                                <Ellipse x:Name="KnobFace" Width="{StaticResource SwitchKnobSize}" Height="{StaticResource SwitchKnobSize}"
                                         Fill="{ThemeResource ToggleSwitchKnobFillOff}" />
                            </Grid>
                            <Thumb x:Name="SwitchThumb" AutomationProperties.AccessibilityView="Raw">
                                <Thumb.Template><ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent" /></ControlTemplate></Thumb.Template>
                            </Thumb>
                        </Grid>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
