<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="StencilExtraBold">ms-appx:///Assets/BigShouldersStencilDisplay-ExtraBold.ttf#Big Shoulders Stencil Display ExtraBold</FontFamily>
    <FontFamily x:Key="StencilBold">ms-appx:///Assets/BigShouldersStencilDisplay-Bold.ttf#Big Shoulders Stencil Display</FontFamily>
    <FontFamily x:Key="CourierPrime">ms-appx:///Assets/CourierPrime-Regular.ttf#Courier Prime</FontFamily>

    <!-- These code points are shared by Segoe Fluent Icons and Segoe MDL2 Assets. -->
    <x:String x:Key="FluentHome">&#xE80F;</x:String>
    <x:String x:Key="FluentLive">&#xE870;</x:String>
    <x:String x:Key="FluentVideoClip">&#xE714;</x:String>
    <x:String x:Key="FluentStack">&#xE7C4;</x:String>
    <x:String x:Key="FluentSettings">&#xE713;</x:String>
    <x:String x:Key="FluentAdd">&#xE710;</x:String>
    <x:String x:Key="FluentAddSmall">&#xE710;</x:String>
    <x:String x:Key="FluentSearch">&#xE721;</x:String>
    <x:String x:Key="FluentFilter">&#xE71C;</x:String>
    <x:String x:Key="FluentBookmark">&#xE8A4;</x:String>
    <x:String x:Key="FluentCopy">&#xE8C8;</x:String>
    <x:String x:Key="FluentRefresh">&#xE72C;</x:String>
    <x:String x:Key="FluentDesktop">&#xE7F3;</x:String>
    <x:String x:Key="FluentCheck">&#xE73E;</x:String>
    <x:String x:Key="FluentCheckCircle">&#xE930;</x:String>
    <x:String x:Key="FluentChevronDown">&#xE70D;</x:String>
    <x:String x:Key="FluentChevronUp">&#xE70E;</x:String>
    <x:String x:Key="FluentChevronRight">&#xE76C;</x:String>
    <x:String x:Key="FluentPeopleCommunity">&#xE716;</x:String>
    <x:String x:Key="FluentPerson">&#xE77B;</x:String>
    <x:String x:Key="FluentShieldCheckmark">&#xEA18;</x:String>
    <x:String x:Key="FluentArrowDownload">&#xE896;</x:String>
    <x:String x:Key="FluentPlayOutline">&#xE768;</x:String>
    <x:String x:Key="FluentGauge">&#xEC4A;</x:String>
    <x:String x:Key="FluentChevronLeft">&#xE76B;</x:String>
    <x:String x:Key="FluentHistory">&#xE81C;</x:String>
    <x:String x:Key="FluentFolder">&#xE8B7;</x:String>
    <x:String x:Key="FluentDocument">&#xE8A5;</x:String>
    <x:String x:Key="FluentStar">&#xE734;</x:String>
    <x:String x:Key="FluentLock">&#xE72E;</x:String>
    <x:String x:Key="FluentLockClosed">&#xE72E;</x:String>
    <x:String x:Key="FluentEye">&#xE890;</x:String>
    <x:String x:Key="FluentShare">&#xE72D;</x:String>
    <x:String x:Key="FluentTag">&#xE8EC;</x:String>
    <x:String x:Key="FluentMore">&#xE712;</x:String>
    <x:String x:Key="FluentImage">&#xE91B;</x:String>
    <x:String x:Key="FluentHeartPulse">&#xE95E;</x:String>
    <x:String x:Key="FluentBookmarkFilled">&#xE728;</x:String>
    <x:String x:Key="FluentPlay">&#xE768;</x:String>
    <x:String x:Key="FluentStarFilled">&#xE735;</x:String>
    <x:String x:Key="FluentStop">&#xE71A;</x:String>

    <Style x:Key="LauncherAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="HighContrastAdjustment" Value="None" />
    </Style>
    <Style x:Key="PrivacyQuestionIcon" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource HeroAccentBrush}" />
    </Style>
    <Style x:Key="CrashFlyoutPresenter" TargetType="FlyoutPresenter">
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="IsTabStop" Value="True" />
    </Style>
    <Style x:Key="SolidCrashFlyoutPresenter" TargetType="FlyoutPresenter"
           BasedOn="{StaticResource CrashFlyoutPresenter}">
        <Setter Property="Background" Value="{ThemeResource PanelBrush}" />
    </Style>

    <Style x:Key="HeroTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StencilExtraBold}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="132" />
        <Setter Property="LineHeight" Value="113.52" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <!-- The font's ink rises above the shortened line box. -->
        <Setter Property="Margin" Value="0,24,0,-24" />
        <Setter Property="CharacterSpacing" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource HeroInkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
    </Style>
    <Style x:Key="StencilText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StencilBold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource HeroAccentBrush}" />
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CourierPrime}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextLineBounds" Value="Tight" />
    </Style>
    <Style x:Key="MonoCaption" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
        <Setter Property="Foreground" Value="{ThemeResource TertiaryBrush}" />
    </Style>
    <Style x:Key="AddressText" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
        <Setter Property="Foreground" Value="{ThemeResource AddressBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="MonoField" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource CourierPrime}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource HeadingBrush}" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource HeadingBrush}" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{ThemeResource HeadingBrush}" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>
    <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource CaptionBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="PositiveCaption" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
        <Setter Property="Foreground" Value="{ThemeResource PositiveBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="PositiveIcon" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource PositiveBrush}" />
    </Style>
    <Style x:Key="NegativeText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
        <Setter Property="Foreground" Value="{ThemeResource NegativeBrush}" />
    </Style>
    <Style x:Key="NegativeButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource NegativeBrush}" />
    </Style>
    <Style x:Key="ColumnHeading" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource CaptionBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="0,0,8,0" />
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource StencilText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="200" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="HeroEyebrow" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CharacterSpacing" Value="340" />
    </Style>
    <Style x:Key="EmptyIcon" TargetType="FontIcon">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="Foreground" Value="{ThemeResource TertiaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
    </Style>
    <Style x:Key="EmptyHeading" TargetType="TextBlock" BasedOn="{StaticResource StencilText}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="Foreground" Value="{ThemeResource ChipIconBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>
    <Style x:Key="SelectionPill" TargetType="Border">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="16" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{ThemeResource LauncherSelectionPillBrush}" />
        <Setter Property="HighContrastAdjustment" Value="None" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>
    <Style x:Key="SidebarItem" TargetType="ListViewItem">
        <Setter Property="HighContrastAdjustment" Value="None" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,0,12,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="SidebarAction" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="16,0,12,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{ThemeResource LinkBrush}" />
    </Style>
    <Style x:Key="InitialTile" TargetType="Border">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="{ThemeResource ControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style x:Key="LoadoutInitial" TargetType="TextBlock" BasedOn="{StaticResource StencilText}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="MediaTile" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillBrush}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style x:Key="SmallAction" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,3" />
    </Style>
    <Style x:Key="SmallSubtleAction" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="HighContrastAdjustment" Value="None" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style x:Key="SubtleLinkAction" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="HighContrastAdjustment" Value="None" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource LinkBrush}" />
    </Style>
    <Style x:Key="SubtleAction" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}" />
    <Style x:Key="SetupFactLabel" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TertiaryBrush}" />
    </Style>
    <Style x:Key="IconAction" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="HighContrastAdjustment" Value="None" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="FavoriteAction" TargetType="Button" BasedOn="{StaticResource IconAction}">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style x:Key="SettingsNote" TargetType="InfoBar">
        <Setter Property="Background" Value="{ThemeResource SettingsNoteBackground}" />
    </Style>
    <Style x:Key="EditionTag" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeBrush}" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style x:Key="Cod2xTag" TargetType="Border" BasedOn="{StaticResource EditionTag}">
        <Setter Property="BorderBrush" Value="{ThemeResource EditionStrokeBrush}" />
    </Style>
    <Style x:Key="AlignedSelector" TargetType="SelectorBar">
        <Setter Property="Margin" Value="-12,0,0,0" />
    </Style>
    <Style x:Key="Keycap" TargetType="Button" BasedOn="{StaticResource SmallAction}">
        <Setter Property="FontFamily" Value="{StaticResource CourierPrime}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{ThemeResource ControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeBrush}" />
    </Style>
    <Style x:Key="AddKeycap" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource LinkBrush}" />
    </Style>
    <Style x:Key="SetupHeroScrim" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SetupHeroScrimBrush}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style x:Key="SetupArtName" TargetType="TextBlock" BasedOn="{StaticResource StencilText}">
        <Setter Property="FontSize" Value="46" />
        <Setter Property="Foreground" Value="{ThemeResource HeroInkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="2" />
    </Style>
    <Style x:Key="SetupArtDescription" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
        <Setter Property="Foreground" Value="{ThemeResource HeroInkBrush}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="2" />
    </Style>
    <Style x:Key="SetupArtBackplate" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource HeroBackplateBrush}" />
    </Style>
    <Style x:Key="SetupAvatar" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HeroAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="SetupCard" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style x:Key="CardDivider" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SeparatorBrush}" />
    </Style>
    <Style x:Key="FieldCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FieldBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="ReviewRow" TargetType="Border" BasedOn="{StaticResource FieldCard}">
        <Setter Property="Padding" Value="12,8" />
    </Style>
</ResourceDictionary>
