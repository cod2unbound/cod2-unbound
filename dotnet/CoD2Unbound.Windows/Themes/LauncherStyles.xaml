    <!-- The Settings window's pane bar (SettingsTabBar): a symbol over a name, 84 x 50, 12 radius; the chosen
         pane a neutral fill with its name in the accent. -->
    <Style x:Key="SettingsTabItem" TargetType="SelectorBarItem">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Foreground" Value="{ThemeResource secondary}" />
        <Setter Property="CornerRadius" Value="{StaticResource NavItemRadius}" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="Width" Value="84" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusVisualPrimaryBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource FocusStroke}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualMargin" Value="{StaticResource FocusMargin}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="SelectorBarItem">
                    <Grid x:Name="PART_ContainerRoot" CornerRadius="{TemplateBinding CornerRadius}" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CombinedStates">
                                <VisualState x:Name="UnselectedNormal" />
                                <VisualState x:Name="UnselectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ContainerRoot.Background" Value="{ThemeResource hover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="UnselectedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ContainerRoot.Background" Value="{ThemeResource press}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedNormal">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ContainerRoot.Background" Value="{ThemeResource button}" />
                                        <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource accent}" />
                                        <Setter Target="PART_TextVisual.FontWeight" Value="SemiBold" />
                                        <Setter Target="PART_IconVisual.Foreground" Value="{ThemeResource accent}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ContainerRoot.Background" Value="{ThemeResource button}" />
                                        <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource accent}" />
                                        <Setter Target="PART_TextVisual.FontWeight" Value="SemiBold" />
                                        <Setter Target="PART_IconVisual.Foreground" Value="{ThemeResource accent}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ContainerRoot.Background" Value="{ThemeResource button}" />
                                        <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource accent}" />
                                        <Setter Target="PART_TextVisual.FontWeight" Value="SemiBold" />
                                        <Setter Target="PART_IconVisual.Foreground" Value="{ThemeResource accent}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DisabledStates">
                                <VisualState x:Name="Enabled" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource disabledInk}" />
                                        <Setter Target="PART_IconVisual.Foreground" Value="{ThemeResource disabledInk}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="PART_IconVisual" Content="{TemplateBinding Icon}" Foreground="{TemplateBinding Foreground}"
                                              Height="22" HorizontalAlignment="Center" />
                            <TextBlock x:Name="PART_TextVisual" Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SettingsTabBar" TargetType="SelectorBar" BasedOn="{StaticResource Segmented}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
