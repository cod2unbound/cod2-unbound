    <!-- WinUI's internal DefaultSelectorBarItemStyle cannot be resolved from app XAML. -->
    <Style x:Key="SegmentItem" TargetType="SelectorBarItem">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Foreground" Value="{ThemeResource secondary}" />
        <Setter Property="CornerRadius" Value="{StaticResource SegmentItemRadius}" />
        <Setter Property="FontSize" Value="{StaticResource HelpSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusVisualPrimaryBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource FocusStroke}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualMargin" Value="{StaticResource FocusMargin}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="SelectorBarItem">
                    <Grid x:Name="PART_ContainerRoot" CornerRadius="{TemplateBinding CornerRadius}"
                          Background="Transparent" MinHeight="{TemplateBinding MinHeight}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CombinedStates">
                                <VisualState x:Name="UnselectedNormal" />
                                <VisualState x:Name="UnselectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ContainerRoot.Background" Value="{ThemeResource SelectorBarItemBackgroundPointerOver}" />
                                        <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundPointerOver}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="UnselectedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ContainerRoot.Background" Value="{ThemeResource SelectorBarItemBackgroundPressed}" />
                                        <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedNormal">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ContainerRoot.Background" Value="{ThemeResource SelectorBarItemBackgroundSelected}" />
                                        <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundSelected}" />
                                        <Setter Target="PART_IconVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundSelected}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ContainerRoot.Background" Value="{ThemeResource SelectorBarItemBackgroundSelectedPointerOver}" />
