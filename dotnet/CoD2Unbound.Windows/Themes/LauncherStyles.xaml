                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SecondaryAsDefaultButton">
                                            <VisualState.Setters>
                                            <Setter Target="SecondaryButton.Style" Value="{StaticResource SheetAccentButton}" />
