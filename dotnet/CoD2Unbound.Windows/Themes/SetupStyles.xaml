<!-- Setup's pieces (Mac SetupView.swift; boards WinSetup and WinSetupEnd). Every colour, radius and size
     comes from DesignTokens.xaml or LauncherStyles.xaml; the few Setup-only measures are the Mac's own:
     the 660 panel at radius 22 (the sidebar's radius), the 56 footer capsule and key field, the 84 crate. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="SetupKeyFont">ms-appx:///Assets/CourierPrime-Bold.ttf#Courier Prime</FontFamily>
    <x:Double x:Key="SetupBarHeight">56</x:Double>
    <CornerRadius x:Key="SetupBarRadius">28</CornerRadius>

    <!-- The footer's 36-point capsules: Back, Cancel, the step's second action and its main one. -->
    <Style x:Key="SetupAction" TargetType="Button" BasedOn="{StaticResource MediumButton}" />
    <Style x:Key="SetupPrimary" TargetType="Button" BasedOn="{StaticResource LauncherAccentButton}">
        <Setter Property="CornerRadius" Value="{StaticResource ButtonMediumRadius}" />
        <Setter Property="MinHeight" Value="{StaticResource ButtonMediumHeight}" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <Style x:Key="SetupEyebrow" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
        <Setter Property="LineHeight" Value="13" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource accent}" />
    </Style>
    <!-- SetupView.swift: 30 bold (40 on Welcome). SF moves to its Display cut from 20 pt, so the title takes
         the system font's Display optical size; Windows 10 has no Segoe UI Variable and uses Segoe UI. -->
    <Style x:Key="SetupTitle" TargetType="TextBlock" BasedOn="{StaticResource TypePage}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="Foreground" Value="{ThemeResource inkOnArt}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
    </Style>
    <Style x:Key="SetupSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CardSize}" />
        <Setter Property="CharacterSpacing" Value="25" />
        <Setter Property="LineHeight" Value="21.75" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{ThemeResource inkOnArt}" />
        <Setter Property="Opacity" Value="0.82" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="560" />
    </Style>

    <!-- SetupView's content surface: acrylic or opaque fill with one panel stroke. -->
    <Style x:Key="SetupPanel" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource SidebarRadius}" />
        <Setter Property="Background" Value="{ThemeResource GlassAcrylicBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource panelStroke}" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke}" />
    </Style>
    <Style x:Key="SetupGlassHighlight" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource glassHighlight}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="SetupBar" TargetType="Border" BasedOn="{StaticResource SetupPanel}">
        <Setter Property="CornerRadius" Value="{StaticResource SetupBarRadius}" />
        <Setter Property="Height" Value="{StaticResource SetupBarHeight}" />
        <Setter Property="MaxWidth" Value="860" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="24,0,24,22" />
        <Setter Property="Padding" Value="10,0" />
    </Style>
    <!-- A group inside the glass: the well at radius 16. -->
    <Style x:Key="SetupGroup" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource CrateRadius}" />
        <Setter Property="Background" Value="{ThemeResource well}" />
        <Setter Property="BorderBrush" Value="{ThemeResource wellStroke}" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke}" />
    </Style>
    <Style x:Key="SetupBanner" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource BannerRadius}" />
        <Setter Property="Background" Value="{ThemeResource well}" />
        <Setter Property="BorderBrush" Value="{ThemeResource wellStroke}" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke}" />
        <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style x:Key="SetupRowTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
    </Style>
    <Style x:Key="SetupMonoTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SetupKeyFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="Foreground" Value="{ThemeResource text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style x:Key="SetupDetail" TargetType="TextBlock" BasedOn="{StaticResource TypeHelp}">
        <Setter Property="Foreground" Value="{ThemeResource secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SetupStepLabel" TargetType="TextBlock" BasedOn="{StaticResource SetupDetail}">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- The CD key: a 56-point capsule in the mono face, typed text visible as on the Mac. The outer border
         draws the stroke so focus, a mismatch and a verified key each get their own colour. -->
    <!-- The Mac's quiet action (See What's Sent…): link weight, not a capsule. -->
    <Style x:Key="SetupLink" TargetType="Button" BasedOn="{StaticResource SubtleLinkAction}">
        <Setter Property="Foreground" Value="{ThemeResource link}" />
        <Setter Property="FontSize" Value="{StaticResource HelpSize}" />
        <Setter Property="MinHeight" Value="{StaticResource ButtonSmallHeight}" />
    </Style>

    <Style x:Key="SetupKeyBox" TargetType="TextBox" BasedOn="{StaticResource InlineTextBox}">
        <Setter Property="FontFamily" Value="{StaticResource SetupKeyFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="CharacterSpacing" Value="118" />
        <Setter Property="Background" Value="{ThemeResource well}" />
        <Setter Property="BorderBrush" Value="{ThemeResource wellStroke}" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke}" />
        <Setter Property="MinHeight" Value="{StaticResource SetupBarHeight}" />
        <Setter Property="Padding" Value="23,13,23,0" />
        <Setter Property="CornerRadius" Value="{StaticResource SetupBarRadius}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="IsSpellCheckEnabled" Value="False" />
        <Setter Property="IsTextPredictionEnabled" Value="False" />
    </Style>

    <!-- The display crates on Make it yours: radio buttons drawn as the Mac's crate. -->
    <Style x:Key="SetupCrate" TargetType="RadioButton">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="84" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="CornerRadius" Value="{StaticResource CrateRadius}" />
        <Setter Property="Background" Value="{ThemeResource crate}" />
        <Setter Property="BorderBrush" Value="{ThemeResource wellStroke}" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke}" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusVisualPrimaryBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource FocusStroke}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualMargin" Value="{StaticResource FocusMargin}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                          MinHeight="{TemplateBinding MinHeight}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Opacity" Value="1" />
                                        <Setter Target="Hover.Background" Value="{ThemeResource press}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource selection}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource selectionStroke}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Hover" Opacity="0" Background="{ThemeResource hover}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="Top" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SetupCrateTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource heading}" />
    </Style>
    <Style x:Key="SetupCrateDetail" TargetType="TextBlock" BasedOn="{StaticResource TypeLabel}">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SetupBadge" TargetType="Border" BasedOn="{StaticResource EditionTag}">
        <Setter Property="BorderBrush" Value="{ThemeResource selectionStroke}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="SetupColourChip" TargetType="Button" BasedOn="{StaticResource ChipButton}">
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
</ResourceDictionary>
