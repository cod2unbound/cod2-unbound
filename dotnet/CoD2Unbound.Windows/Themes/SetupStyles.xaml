<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Style x:Key="SetupEyebrow" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource accent}" />
    </Style>
    <Style x:Key="SetupTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource inkOnArt}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
    </Style>
    <Style x:Key="SetupSubtitle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource inkOnArt}" />
        <Setter Property="Opacity" Value="0.82" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="560" />
    </Style>

    <Style x:Key="SetupPanel" TargetType="Border">
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource panelStroke}" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke}" />
    </Style>
    <Style x:Key="SetupGroup" TargetType="Border">
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource well}" />
        <Setter Property="BorderBrush" Value="{ThemeResource wellStroke}" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke}" />
    </Style>
    <Style x:Key="SetupBanner" TargetType="Border">
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource well}" />
        <Setter Property="BorderBrush" Value="{ThemeResource wellStroke}" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke}" />
        <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style x:Key="SetupRowTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
    </Style>
    <Style x:Key="SetupMonoTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style x:Key="SetupDetail" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SetupStepLabel" TargetType="TextBlock" BasedOn="{StaticResource SetupDetail}">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SetupLink" TargetType="Button" BasedOn="{StaticResource SubtleLinkAction}" />

    <Style x:Key="SetupKeyBox" TargetType="TextBox" BasedOn="{StaticResource InlineTextBox}">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="IsSpellCheckEnabled" Value="False" />
        <Setter Property="IsTextPredictionEnabled" Value="False" />
    </Style>

    <Style x:Key="SetupCrate" TargetType="RadioButton">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="SetupCrateTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource heading}" />
    </Style>
    <Style x:Key="SetupCrateDetail" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SetupBadge" TargetType="Border" BasedOn="{StaticResource EditionTag}">
        <Setter Property="BorderBrush" Value="{ThemeResource selectionStroke}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="SetupColourChip" TargetType="Button" BasedOn="{StaticResource ChipButton}" />
</ResourceDictionary>
