<Window
    x:Class="CoD2Unbound.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="using:CoD2Unbound.Windows"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CoD2 Unbound">
    <Grid x:Name="Root" Background="{ThemeResource FrameContrastBrush}"
          Loaded="OnLoaded" SizeChanged="OnSizeChanged">
        <Border Background="{ThemeResource GroundBrush}" IsHitTestVisible="False" />
        <!-- Backdrop host (PcHome, pc.css .win): one window surface. A page's art fills the whole window,
             under the sidebar glass and the caption buttons; pages hand it over through IShellBackdrop. -->
        <Border x:Name="BackdropHost" IsHitTestVisible="False" />

        <Border x:Name="SidebarGlass" HorizontalAlignment="Left"
                Width="{StaticResource SidebarWidth}" Margin="{StaticResource SidebarMargin}"
                Visibility="Collapsed" Background="{ThemeResource GlassAcrylicBrush}"
                CornerRadius="{StaticResource SidebarRadius}" BorderBrush="{ThemeResource glassStroke}"
                BorderThickness="{StaticResource Stroke}" IsHitTestVisible="False">
            <Border.Shadow><ThemeShadow /></Border.Shadow>
            <Border Margin="1" CornerRadius="{StaticResource SidebarRadius}" BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource glassHighlight}" />
        </Border>

        <NavigationView x:Name="Nav" Margin="10,0,0,0" PaneDisplayMode="Left" IsPaneOpen="True"
                        Background="Transparent" OpenPaneLength="{StaticResource SidebarWidth}"
                        CompactPaneLength="{StaticResource SidebarCompactLength}" IsBackButtonVisible="Collapsed" IsPaneVisible="False"
                        IsTitleBarAutoPaddingEnabled="False" AlwaysShowHeader="False"
                        IsSettingsVisible="False"
                        ItemInvoked="OnNavigation" PaneOpened="OnPaneChanged" PaneClosed="OnPaneChanged">
            <NavigationView.Resources>
                <!-- PcSide / launcher.css .side: the pane sits inside the inset glass. Every row lines up on three
                     verticals by construction: fills and the plate at SidebarInset (13 from the panel's edge,
                     both sides), glyph centres at 34 (the icon column is SidebarCompactLength - 8 = 42 wide),
                     labels at 55 (no presenter margin after the icon column). -->
                <Thickness x:Key="NavigationViewPaneContentGridMargin">0,13,0,0</Thickness>
                <Thickness x:Key="NavigationViewButtonHolderGridMargin">2,14,0,4</Thickness>
                <Thickness x:Key="NavigationViewItemButtonMargin">13,2</Thickness>
                <x:Double x:Key="NavigationViewItemOnLeftMinHeight">38</x:Double>
                <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">18</x:Double>
                <Thickness x:Key="NavigationViewItemContentPresenterMargin">0,-1,-2,-1</Thickness>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.PaneCustomContent>
                <!-- The board's second header row: the mark (36) on the fills' column + 10, the wordmark beside it. -->
                <StackPanel x:Name="BrandHeader" Orientation="Horizontal" Spacing="10" Margin="23,11,0,20"
                            AutomationProperties.Name="CoD2 Unbound">
                    <Image Source="ms-appx:///Assets/mark-48.png" Width="36" Height="36"
                           AutomationProperties.AccessibilityView="Raw" />
                    <Image x:Name="BrandWordmark" Width="102" Height="15"
                           AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="ContrastWordmark" Text="CoD2 Unbound" Style="{StaticResource TypeLabel}"
                               VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
                </StackPanel>
            </NavigationView.PaneCustomContent>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Content="Home" AccessKey="H" Style="{StaticResource ShellNavItem}">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentHome}" FontSize="18" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ServersItem" Content="Servers" AccessKey="S" Style="{StaticResource ShellNavItem}">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentLive}" FontSize="18" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LibraryItem" Content="Library" AccessKey="L" Style="{StaticResource ShellNavItem}">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentVideoClip}" FontSize="18" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ConfigsItem" Content="Configs" AccessKey="C" Style="{StaticResource ShellNavItem}">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentStack}" FontSize="18" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel x:Name="PaneFooterStack">
                <!-- The Mac's footer order: the labelled Settings entry, a hairline, then the player plate. -->
                <Button x:Name="SettingsItem" Style="{StaticResource SidebarSettingsButton}" Click="OnSettingsEntry"
                        AutomationProperties.Name="Settings" AutomationProperties.AcceleratorKey="Ctrl+,"
                        ToolTipService.ToolTip="Settings (Ctrl+,)" AccessKey="T">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentSettings}" FontSize="18"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="SettingsLabel" Text="Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border x:Name="FooterRule" Height="1" Margin="21,10,21,12" Background="{ThemeResource separator}" />
                <Button x:Name="PlayerPlate" Margin="13,0,13,19" HorizontalAlignment="Stretch"
                        Style="{StaticResource PlayerPlateButton}"
                        HorizontalContentAlignment="Stretch" Visibility="Collapsed"
                        AutomationProperties.Name="Open your player card" AccessKey="P">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <ContentControl Style="{StaticResource MiniDogTag}" AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock x:Name="PlayerName" FontWeight="SemiBold" Text="Player"
                                       FontSize="{StaticResource SubtitleSize}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PaneLoadout" Style="{StaticResource TypeLabel}"
                                       Foreground="{ThemeResource secondary}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentChevronRight}"
                                  FontSize="11" Foreground="{ThemeResource tertiary}"
                                  AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <Button.Flyout>
                        <Flyout Opening="OnPlayerCardOpened" Closed="OnPlayerCardClosed" Placement="Right">
                            <TextBlock Text="Player card" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Border Background="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="ShellNotices">
                        <InfoBar x:Name="Problem" Severity="Error" IsClosable="False" />
                        <InfoBar x:Name="ReportCopied" Severity="Success" />
                        <InfoBar x:Name="ReportWarning" Severity="Warning" />
                    </StackPanel>
                    <Frame x:Name="ContentFrame" Grid.Row="1" />
                </Grid>
            </Border>
        </NavigationView>

        <!-- The caption strip: drag region over the page art, right of the sidebar; the system's caption
             buttons sit over it at the top right. Nothing pressable lives in it. -->
        <Grid x:Name="WindowBar" Height="{StaticResource CaptionHeight}" VerticalAlignment="Top" Background="Transparent" />

        <!-- Jump to (JumpPalette.swift, HomeJump board): a light-dismiss popup centred over the window, opened
             with Ctrl+K, holding a real TextBox and a real ListView. A click outside closes it, as on the Mac. -->
        <Popup x:Name="JumpPopup" IsLightDismissEnabled="True" LightDismissOverlayMode="Off">
            <Border x:Name="JumpPanel" Width="640"
                    CornerRadius="{StaticResource SheetRadius}" Background="{ThemeResource GlassAcrylicBrush}"
                    BorderBrush="{ThemeResource glassStroke}" BorderThickness="{StaticResource Stroke}"
                    Translation="0,0,32" AutomationProperties.Name="Jump to" AutomationProperties.LandmarkType="Search">
                <Border.Shadow><ThemeShadow /></Border.Shadow>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="44" />
                    </Grid.RowDefinitions>
                    <Grid Padding="18,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentSearch}" FontSize="17"
                                  Foreground="{ThemeResource secondary}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <TextBox x:Name="JumpBox" Grid.Column="1" Style="{StaticResource JumpField}"
                                 PlaceholderText="Servers, loadouts, settings and actions"
                                 AutomationProperties.Name="Jump to" AutomationProperties.AcceleratorKey="Ctrl+K">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>
                        <Border Grid.Column="2" Style="{StaticResource KeyCapLabel}" AutomationProperties.Name="Escape closes">
                            <TextBlock Text="esc" Style="{StaticResource KeyCapText}" />
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Height="1" Background="{ThemeResource separator}" />
                    <ListView x:Name="JumpList" Grid.Row="2" MaxHeight="380" Padding="0,8" SelectionMode="Single"
                              IsItemClickEnabled="True" ItemClick="OnJumpItemClick" SelectionChanged="OnJumpSelectionChanged"
                              ItemContainerStyle="{StaticResource JumpRowItem}" IsTabStop="False"
                              AutomationProperties.Name="Results">
                        <ListView.Resources>
                            <!-- Section labels are disabled items so the arrow keys skip them; keep them at full ink. -->
                            <x:Double x:Key="ListViewItemDisabledThemeOpacity">1</x:Double>
                        </ListView.Resources>
                    </ListView>
                    <TextBlock x:Name="JumpEmpty" Grid.Row="2" Margin="20,18" TextWrapping="Wrap" Visibility="Collapsed"
                               FontSize="{StaticResource SubtitleSize}" Foreground="{ThemeResource secondary}" />
                    <Grid Grid.Row="3" Padding="14,0" BorderBrush="{ThemeResource separator}" BorderThickness="0,1,0,0"
                          AutomationProperties.Name="Up and Down to move, Enter to open, Ctrl+Enter to launch on a server">
                        <StackPanel x:Name="JumpFooter" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
