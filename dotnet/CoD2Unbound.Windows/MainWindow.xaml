<Window
    x:Class="CoD2Unbound.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CoD2 Unbound">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root" Background="{ThemeResource FrameContrastBrush}"
          Loaded="OnLoaded" SizeChanged="OnSizeChanged">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnJumpShortcut" />
            <KeyboardAccelerator Key="F11" Invoked="OnFullScreen" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="WindowBar" Title="CoD2 Unbound" Height="48">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/monogram.svg" />
            </TitleBar.IconSource>
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.Content>
                <Grid x:Name="JumpHost" SizeChanged="OnJumpHostSizeChanged">
                    <Button x:Name="JumpButton" HorizontalAlignment="Center" HorizontalContentAlignment="Stretch"
                            Width="300" IsEnabled="False" AutomationProperties.Name="Jump to…"
                            AutomationProperties.AcceleratorKey="Ctrl+K" ToolTipService.ToolTip="Jump to… (Ctrl+K)">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Symbol="Find" />
                            <TextBlock Grid.Column="1" Text="Jump to…" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Ctrl+K" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </Grid>
                        <Button.Flyout>
                            <MenuFlyout x:Name="JumpMenu">
                                <MenuFlyoutItem Text="Home" Click="OnHomeInvoked" />
                                <MenuFlyoutItem Text="Settings" Click="OnSettingsInvoked" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="320"
                        CompactPaneLength="48" IsBackButtonVisible="Collapsed" IsPaneVisible="False"
                        IsTitleBarAutoPaddingEnabled="False" AlwaysShowHeader="False"
                        ItemInvoked="OnNavigation" PaneOpened="OnPaneChanged" PaneClosed="OnPaneChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Content="Home" Icon="Home" />
                <NavigationViewItem Content="Servers" Icon="Globe" IsEnabled="False" />
                <NavigationViewItem Content="Library" Icon="Library" IsEnabled="False" />
                <NavigationViewItem Content="Configs" Icon="Document" IsEnabled="False" />
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <TextBlock x:Name="PaneLoadout" Margin="16,8" Style="{StaticResource SecondaryText}"
                           Visibility="Collapsed" />
            </NavigationView.PaneFooter>

            <Border BorderBrush="{ThemeResource PanelStrokeBrush}" BorderThickness="1,1,0,0"
                    Background="{ThemeResource PanelBrush}" CornerRadius="8,0,0,0">
                <ScrollViewer>
                    <StackPanel Padding="32" Spacing="16">
                        <InfoBar x:Name="Problem" Severity="Error" IsClosable="False" />
                        <StackPanel x:Name="SetupPage" Visibility="Collapsed" MaxWidth="680"
                                    HorizontalAlignment="Center" Spacing="16" Padding="0,36,0,16">
                            <TextBlock x:Name="SetupTitle" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="SetupDescription" Style="{StaticResource SecondaryText}" />
                            <Border x:Name="SetupDataCard" Style="{StaticResource FieldCard}" Visibility="Collapsed">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Name="SetupDataStatus" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="SetupDataDetail" Style="{StaticResource SecondaryText}" />
                                    <TextBlock x:Name="SetupDataPath" TextWrapping="Wrap"
                                               Foreground="{ThemeResource BodyBrush}" />
                                    <Button Content="Choose a folder…" Click="OnChooseSetupFolder" />
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="SetupKeyCard" Visibility="Collapsed" Spacing="12">
                                <TextBlock x:Name="StoredKey" Text="A CD key is stored in Windows Credential Manager."
                                           Style="{StaticResource SecondaryText}" />
                                <Button x:Name="ReplaceKey" Content="Replace key…" Click="OnReplaceKey" />
                                <PasswordBox x:Name="KeyInput" Header="CD key" PasswordChanged="OnKeyChanged"
                                             PasswordRevealMode="Hidden" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SetupNext" Content="Continue" Click="OnContinueSetup"
                                        Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Name="SetupBack" Content="Back" Click="OnSetupBack" />
                                <Button x:Name="SkipKey" Content="Skip for now" Click="OnSkipKey" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="HomePage" Visibility="Collapsed" Spacing="16">
                            <TextBlock Text="Home" Style="{StaticResource PageTitle}" />
                            <Border Style="{StaticResource FieldCard}" Padding="24">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Play" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="HomeEdition" Foreground="{ThemeResource BodyBrush}" />
                                    <TextBlock x:Name="HomeDataStatus" Style="{StaticResource SecondaryText}" />
                                    <TextBlock x:Name="HomeLoadout" Foreground="{ThemeResource BodyBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="LaunchButton" IsEnabled="False" MinWidth="140"
                                                Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="Launch">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <SymbolIcon Symbol="Play" />
                                                <TextBlock Text="Launch" />
                                            </StackPanel>
                                        </Button>
                                        <Button Content="Open Game Data" Click="OnSettingsInvoked" />
                                    </StackPanel>
                                    <TextBlock x:Name="LaunchReason" Style="{StaticResource SecondaryText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="SettingsPage" Visibility="Collapsed" Spacing="16">
                            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Game Data" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource FieldCard}">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Name="SettingsDataStatus" Foreground="{ThemeResource BodyBrush}" />
                                    <TextBlock x:Name="SettingsDataDetail" Style="{StaticResource SecondaryText}" />
                                    <TextBlock x:Name="SettingsDataPath" TextWrapping="Wrap"
                                               Foreground="{ThemeResource BodyBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Choose a folder…" Click="OnChooseSettingsFolder" />
                                        <StackPanel x:Name="SettingsDataActions" Visibility="Collapsed"
                                                    Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="SaveFolder" Content="Use this folder" Click="OnSaveFolder"
                                                    Style="{StaticResource AccentButtonStyle}" />
                                            <Button Content="Cancel" Click="OnCancelFolder" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Game" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource FieldCard}">
                                <ComboBox x:Name="EditionChoice" Header="Game version" SelectionChanged="OnSettingsChanged">
                                    <ComboBoxItem Content="CoD2x 1.4.6.8" />
                                    <ComboBoxItem Content="Original 1.3" />
                                </ComboBox>
                            </Border>
                            <TextBlock Text="Launcher" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource FieldCard}">
                                <ComboBox x:Name="ThemeChoice" Header="Appearance" SelectionChanged="OnSettingsChanged">
                                    <ComboBoxItem Content="Use system setting" />
                                    <ComboBoxItem Content="Light" />
                                    <ComboBoxItem Content="Dark" />
                                </ComboBox>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </NavigationView>
    </Grid>
</Window>
