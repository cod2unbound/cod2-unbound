<Window
    x:Class="CoD2Unbound.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="using:CoD2Unbound.Windows"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CoD2 Unbound">
    <Grid x:Name="Root" Background="{ThemeResource FrameContrastBrush}"
          Loaded="OnLoaded" SizeChanged="OnSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="SolidFrame" Grid.RowSpan="2" Background="{ThemeResource GroundBrush}"
                IsHitTestVisible="False" />
        <ContentControl x:Name="ClientJumpBar" Visibility="Collapsed" IsTabStop="False"
                        HorizontalContentAlignment="Stretch" />
        <TitleBar x:Name="WindowBar" Title="CoD2 Unbound" Height="48">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.Content>
                <Grid x:Name="JumpHost" Height="48" SizeChanged="OnJumpHostSizeChanged" Visibility="Collapsed">
                    <AutoSuggestBox x:Name="JumpBox" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsEnabled="False" MaxSuggestionListHeight="440" UpdateTextOnSelect="False"
                                    PlaceholderText="Servers, loadouts, settings and actions"
                                    AutomationProperties.Name="Jump to" AutomationProperties.AcceleratorKey="Ctrl+K"
                                    ToolTipService.ToolTip="Jump to… (Ctrl+K)">
                        <AutoSuggestBox.QueryIcon>
                            <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentSearch}" FontSize="20" />
                        </AutoSuggestBox.QueryIcon>
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="local:JumpSuggestion">
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{x:Bind Heading}" Visibility="{x:Bind HeadingVisible}"
                                               Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Margin="0,4,0,4" />
                                    <Grid ColumnSpacing="8" Background="{x:Bind SelectionBrush, Mode=OneWay}"
                                          Opacity="{x:Bind RowOpacity}" Padding="4,3" CornerRadius="4"
                                          AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Visibility="{x:Bind IconVisible}" FontFamily="{StaticResource FluentRegular}"
                                                  Glyph="{x:Bind Icon}" FontSize="16" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" TextWrapping="{x:Bind TitleWrapping}"
                                                       TextTrimming="{x:Bind TitleTrimming}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Detail}" Visibility="{x:Bind DetailVisible}"
                                                       TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Hint, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="↑ ↓ to move · Enter to jump · the setting opens in Expert"
                                               Visibility="{x:Bind FooterVisible}" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,8,0,4" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="320"
                        CompactPaneLength="48" IsBackButtonVisible="Collapsed" IsPaneVisible="False"
                        IsTitleBarAutoPaddingEnabled="False" AlwaysShowHeader="False"
                        ItemInvoked="OnNavigation" PaneOpened="OnPaneChanged" PaneClosed="OnPaneChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Content="Home" AccessKey="H" HighContrastAdjustment="None">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentHome}" FontSize="20" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ServersItem" Content="Servers" AccessKey="S" HighContrastAdjustment="None">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentLive}" FontSize="20" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LibraryItem" Content="Library" AccessKey="L" HighContrastAdjustment="None">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentVideoClip}" FontSize="20" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ConfigsItem" Content="Configs" AccessKey="C" HighContrastAdjustment="None">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentStack}" FontSize="20" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <Button x:Name="PlayerPlate" Margin="8,8" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" Visibility="Collapsed"
                        AutomationProperties.Name="Open your player card" AccessKey="P">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentPerson}" FontSize="20" />
                        <StackPanel>
                            <TextBlock x:Name="PlayerName" FontWeight="SemiBold" Text="Player" />
                            <TextBlock x:Name="PaneLoadout" Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Opening="OnPlayerCardOpened" Closed="OnPlayerCardClosed" Placement="Right">
                            <TextBlock Text="Player card" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </NavigationView.PaneFooter>

            <Border BorderBrush="{ThemeResource PanelStrokeBrush}" BorderThickness="1,1,0,0"
                    Background="{ThemeResource PanelBrush}" CornerRadius="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <InfoBar x:Name="Problem" Severity="Error" IsClosable="False" />
                        <InfoBar x:Name="ReportCopied" Severity="Success" />
                        <InfoBar x:Name="ReportWarning" Severity="Warning" />
                    </StackPanel>
                    <Frame x:Name="ContentFrame" Grid.Row="1" />
                </Grid>
            </Border>
        </NavigationView>
    </Grid>
</Window>
