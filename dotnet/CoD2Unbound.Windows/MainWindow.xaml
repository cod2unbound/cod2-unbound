<Window
    x:Class="CoD2Unbound.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="using:CoD2Unbound.Windows"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CoD2 Unbound">
    <Grid x:Name="Root" Background="{ThemeResource FrameContrastBrush}"
          Loaded="OnLoaded" SizeChanged="OnSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="SolidGround" Grid.RowSpan="2" Background="{ThemeResource GroundBrush}"
                IsHitTestVisible="False" />
        <Grid x:Name="WindowBar" Height="48" Background="Transparent" />

        <NavigationView x:Name="Nav" Grid.Row="1" OpenPaneLength="232"
                        IsBackButtonVisible="Collapsed" IsPaneVisible="False"
                        IsTitleBarAutoPaddingEnabled="False" AlwaysShowHeader="False"
                        IsSettingsVisible="False" ItemInvoked="OnNavigation">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0"
                            AutomationProperties.Name="CoD2 Unbound">
                    <Image Source="ms-appx:///Assets/mark-48.png" Width="24" Height="24"
                           AutomationProperties.AccessibilityView="Raw" />
                    <Image x:Name="BrandWordmark" Width="102" Height="15"
                           AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="ContrastWordmark" Text="CoD2 Unbound" Style="{StaticResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Content="Home" AccessKey="H">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentHome}"></FontIcon></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ServersItem" Content="Servers" AccessKey="S">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentLive}"></FontIcon></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LibraryItem" Content="Library" AccessKey="L">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentFilmstrip}"></FontIcon></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ConfigsItem" Content="Configs" AccessKey="C">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentStack}"></FontIcon></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsItem" Content="Settings" SelectsOnInvoked="False"
                                    AutomationProperties.AutomationId="SettingsItem" AutomationProperties.Name="Settings"
                                    AutomationProperties.AcceleratorKey="Ctrl+,"
                                    ToolTipService.ToolTip="Settings (Ctrl+,)" AccessKey="T">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <NavigationView.PaneFooter>
                <Button x:Name="PlayerPlate" Margin="4" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" Padding="8,4"
                        AutomationProperties.Name="Open your player card" AccessKey="P">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <ContentControl Style="{StaticResource MiniDogTag}" AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="PlayerName" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Text="Player" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PaneLoadout" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <Button.Flyout>
                        <Flyout Opening="OnPlayerCardOpened" Closed="OnPlayerCardClosed" Placement="Right">
                            <TextBlock Text="Player card" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </NavigationView.PaneFooter>

            <Grid RowDefinitions="Auto,*">
                <StackPanel x:Name="ShellNotices">
                    <InfoBar x:Name="Problem" Severity="Error" IsClosable="False" />
                    <InfoBar x:Name="ReportCopied" Severity="Success" />
                    <InfoBar x:Name="ReportWarning" Severity="Warning" />
                </StackPanel>
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>

        <!-- Title-bar content (ShellTitleBar.cs): interactive pieces a page places in the caption band, such as
             Home's update pill. The host itself takes no input; the shell keeps a passthrough region over each
             visible child, and the host stays 138 px clear of the caption buttons. -->
        <Grid x:Name="TitleBarContent" Grid.RowSpan="2" VerticalAlignment="Top" Margin="0,0,138,0" />

        <!-- Jump to (JumpPalette.swift, HomeJump board): a light-dismiss popup centred over the window, opened
             with Ctrl+K, holding a real TextBox and a real ListView. A click outside closes it, as on the Mac. -->
        <Popup x:Name="JumpPopup" Grid.RowSpan="2" IsLightDismissEnabled="True" LightDismissOverlayMode="Off">
            <Border x:Name="JumpPanel" Width="640"
                    CornerRadius="{StaticResource SheetRadius}" Background="{ThemeResource GlassAcrylicBrush}"
                    BorderBrush="{ThemeResource glassStroke}" BorderThickness="{StaticResource Stroke}"
                    Translation="0,0,32" AutomationProperties.Name="Jump to" AutomationProperties.LandmarkType="Search">
                <Border.Shadow><ThemeShadow /></Border.Shadow>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="44" />
                    </Grid.RowDefinitions>
                    <Grid Padding="18,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="{StaticResource FluentRegular}" Glyph="{StaticResource FluentSearch}" FontSize="17"
                                  Foreground="{ThemeResource secondary}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <TextBox x:Name="JumpBox" Grid.Column="1" Style="{StaticResource JumpField}"
                                 PlaceholderText="Servers, loadouts, settings and actions"
                                 AutomationProperties.Name="Jump to" AutomationProperties.AcceleratorKey="Ctrl+K">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>
                        <Border Grid.Column="2" Style="{StaticResource KeyCapLabel}" AutomationProperties.Name="Escape closes">
                            <TextBlock Text="esc" Style="{StaticResource KeyCapText}" />
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Height="1" Background="{ThemeResource separator}" />
                    <ListView x:Name="JumpList" Grid.Row="2" MaxHeight="380" Padding="0,8" SelectionMode="Single"
                              SelectionChanged="OnJumpSelectionChanged"
                              ItemContainerStyle="{StaticResource JumpRowItem}" IsTabStop="False"
                              AutomationProperties.Name="Results">
                        <ListView.Resources>
                            <!-- Section labels are disabled items so the arrow keys skip them; keep them at full ink. -->
                            <x:Double x:Key="ListViewItemDisabledThemeOpacity">1</x:Double>
                        </ListView.Resources>
                    </ListView>
                    <TextBlock x:Name="JumpEmpty" Grid.Row="2" Margin="20,18" TextWrapping="Wrap" Visibility="Collapsed"
                               FontSize="{StaticResource SubtitleSize}" Foreground="{ThemeResource secondary}" />
                    <Grid Grid.Row="3" Padding="14,0" BorderBrush="{ThemeResource separator}" BorderThickness="0,1,0,0"
                          AutomationProperties.Name="Up and Down to move, Enter to open, Ctrl+Enter to launch on a server">
                        <StackPanel x:Name="JumpFooter" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
